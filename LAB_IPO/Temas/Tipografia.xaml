<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Segoe UI Variable es la tipografía de Windows 11; Segoe UI queda como respaldo. -->
    <FontFamily x:Key="Fuente.Titulos">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Fuente.Texto">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Fuente.Iconos">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Glifos de Segoe Fluent Icons usados en la aplicación -->
    <sys:String x:Key="Icono.Usuario">&#xE77B;</sys:String>
    <sys:String x:Key="Icono.Ayuda">&#xE897;</sys:String>
    <sys:String x:Key="Icono.Info">&#xE946;</sys:String>
    <sys:String x:Key="Icono.Error">&#xEA39;</sys:String>
    <sys:String x:Key="Icono.Aviso">&#xE7BA;</sys:String>
    <sys:String x:Key="Icono.Pregunta">&#xE9CE;</sys:String>
    <sys:String x:Key="Icono.Correcto">&#xE73E;</sys:String>
    <sys:String x:Key="Icono.Candado">&#xE72E;</sys:String>
    <sys:String x:Key="Icono.Ver">&#xE890;</sys:String>
    <sys:String x:Key="Icono.Ocultar">&#xED1A;</sys:String>
    <sys:String x:Key="Icono.Minimizar">&#xE921;</sys:String>
    <sys:String x:Key="Icono.Maximizar">&#xE922;</sys:String>
    <sys:String x:Key="Icono.Restaurar">&#xE923;</sys:String>
    <sys:String x:Key="Icono.Cerrar">&#xE8BB;</sys:String>

    <!-- Estilos de texto -->
    <Style x:Key="Texto.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fuente.Texto}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Pincel.TextoPrincipal}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="Texto.Display" TargetType="TextBlock" BasedOn="{StaticResource Texto.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Fuente.Titulos}"/>
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Pincel.Bosque800}"/>
    </Style>

    <Style x:Key="Texto.Titulo" TargetType="TextBlock" BasedOn="{StaticResource Texto.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Fuente.Titulos}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Pincel.Bosque800}"/>
    </Style>

    <Style x:Key="Texto.TituloSeccion" TargetType="TextBlock" BasedOn="{StaticResource Texto.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Fuente.Titulos}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Pincel.Bosque800}"/>
    </Style>

    <Style x:Key="Texto.TituloDialogo" TargetType="TextBlock" BasedOn="{StaticResource Texto.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Fuente.Titulos}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Pincel.Bosque800}"/>
    </Style>

    <Style x:Key="Texto.Subtitulo" TargetType="TextBlock" BasedOn="{StaticResource Texto.Base}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource Pincel.TextoSecundario}"/>
    </Style>

    <Style x:Key="Texto.Secundario" TargetType="TextBlock" BasedOn="{StaticResource Texto.Base}">
        <Setter Property="Foreground" Value="{StaticResource Pincel.TextoSecundario}"/>
    </Style>

    <Style x:Key="Texto.Etiqueta" TargetType="TextBlock" BasedOn="{StaticResource Texto.Base}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Texto.Nota" TargetType="TextBlock" BasedOn="{StaticResource Texto.Base}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Pincel.TextoSecundario}"/>
    </Style>

    <!-- Rótulo pequeño en mayúsculas (p. ej. "GESTIÓN DEL CAMPING", "MENÚ PRINCIPAL") -->
    <Style x:Key="Texto.Rotulo" TargetType="TextBlock" BasedOn="{StaticResource Texto.Base}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Pincel.Bosque600}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style x:Key="Icono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fuente.Iconos}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
    </Style>

</ResourceDictionary>
