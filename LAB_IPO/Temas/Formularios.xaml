<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:comp="clr-namespace:LAB_IPO.Componentes">

    <!--
        Estilos de formularios y listados: desplegables, casillas, grupos de campos,
        pestañas, barras de desplazamiento y etiquetas de estado.
    -->

    <comp:RutaImagenConverter x:Key="RutaImagen"/>
    <BooleanToVisibilityConverter x:Key="BoolAVisibilidad"/>

    <!-- ============================================================
         Campo de texto de varias líneas (descripciones, observaciones)
         ============================================================ -->

    <Style x:Key="Campo.TextoLargo" TargetType="TextBox" BasedOn="{StaticResource Campo.Texto}">
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="MinHeight" Value="80"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Borde" CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="Ejemplo" Text="{TemplateBinding comp:CampoAyudante.TextoEjemplo}"
                                       Foreground="{StaticResource Pincel.TextoTenue}" IsHitTestVisible="False"
                                       Margin="14,11,14,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Ejemplo" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Pincel.BordeFuerte}"/>
                        </Trigger>
                        <Trigger Property="comp:CampoAyudante.TieneError" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Pincel.Error}"/>
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Pincel.ErrorFondo}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Pincel.Bosque600}"/>
                            <Setter TargetName="Borde" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Pincel.Blanco}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Desplegable (ComboBox)
         ============================================================ -->

    <Style x:Key="Desplegable.Boton" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <TextBlock Style="{StaticResource Icono}" Text="&#xE70D;" FontSize="11"
                                   HorizontalAlignment="Right" Margin="0,0,14,0"
                                   Foreground="{StaticResource Pincel.TextoSecundario}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Campo.Desplegable" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Fuente.Texto}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Pincel.TextoPrincipal}"/>
        <Setter Property="Background" Value="{StaticResource Pincel.Blanco}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Pincel.Borde}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Borde" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                        <TextBlock x:Name="Ejemplo" Text="{TemplateBinding comp:CampoAyudante.TextoEjemplo}"
                                   Foreground="{StaticResource Pincel.TextoTenue}" IsHitTestVisible="False"
                                   Margin="14,0,36,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <ContentPresenter x:Name="Seleccion" Margin="14,0,36,0" VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <ToggleButton Style="{StaticResource Desplegable.Boton}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" HorizontalOffset="-8" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource Pincel.Blanco}" BorderBrush="{StaticResource Pincel.Borde}"
                                    BorderThickness="1" CornerRadius="10" Padding="4" Margin="8,0,8,12"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Effect="{StaticResource Sombra.Elevada}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="Ejemplo" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Pincel.BordeFuerte}"/>
                        </Trigger>
                        <Trigger Property="comp:CampoAyudante.TieneError" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Pincel.Error}"/>
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Pincel.ErrorFondo}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Pincel.Bosque600}"/>
                            <Setter TargetName="Borde" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Pincel.Blanco}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Pincel.Bosque600}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Pincel.Beige100}"/>
                            <Setter Property="Foreground" Value="{StaticResource Pincel.TextoTenue}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Fuente.Texto}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Pincel.TextoPrincipal}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Fondo" CornerRadius="6" Padding="12,8" Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Beige100}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Salvia100}"/>
                            <Setter Property="Foreground" Value="{StaticResource Pincel.Bosque800}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Casilla de verificación
         ============================================================ -->

    <Style x:Key="Campo.Casilla" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Fuente.Texto}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Pincel.TextoPrincipal}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Fondo" Background="Transparent" CornerRadius="8" Padding="6,6,10,6">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Caja" Width="20" Height="20" CornerRadius="5"
                                    Background="{StaticResource Pincel.Blanco}"
                                    BorderBrush="{StaticResource Pincel.BordeFuerte}" BorderThickness="1.5">
                                <TextBlock x:Name="Marca" Style="{StaticResource Icono}" Text="&#xE73E;" FontSize="12"
                                           Foreground="{StaticResource Pincel.Blanco}" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Beige100}"/>
                            <Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource Pincel.Bosque600}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Caja" Property="Background" Value="{StaticResource Pincel.Bosque700}"/>
                            <Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource Pincel.Bosque700}"/>
                            <Setter TargetName="Marca" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Salvia100}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Grupo de campos (equivale a los FieldSet de los bocetos)
         ============================================================ -->

    <Style x:Key="Grupo" TargetType="GroupBox">
        <Setter Property="Background" Value="{StaticResource Pincel.Blanco}"/>
        <Setter Property="Padding" Value="20,14,20,16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Pincel.Borde}"
                            BorderThickness="1" CornerRadius="14" Effect="{StaticResource Sombra.Tarjeta}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Header}"
                                       Style="{StaticResource Texto.Etiqueta}" FontSize="14"
                                       Foreground="{StaticResource Pincel.Bosque800}" Margin="20,14,20,0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Pestañas (Parcelas / Bungalows)
         ============================================================ -->

    <Style x:Key="Boton.Pestana" TargetType="RadioButton">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="FontFamily" Value="{StaticResource Fuente.Texto}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Pincel.TextoSecundario}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Fondo" CornerRadius="8" Background="Transparent" Padding="18,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Arena200}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Blanco}"/>
                            <Setter TargetName="Fondo" Property="Effect" Value="{StaticResource Sombra.Tarjeta}"/>
                            <Setter Property="Foreground" Value="{StaticResource Pincel.Bosque800}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Pincel.TextoTenue}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón pequeño de acción en las filas de una tabla (Ver, Editar, Eliminar) -->
    <Style x:Key="Boton.Fila" TargetType="Button" BasedOn="{StaticResource Boton.Secundario}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    </Style>

    <!-- ============================================================
         Barra de desplazamiento fina
         ============================================================ -->

    <Style x:Key="Desplazamiento.Pulgar" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Pulgar" CornerRadius="4" Background="{StaticResource Pincel.Arena400}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pulgar" Property="Background" Value="{StaticResource Pincel.Salvia500}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Margin" Value="4,2,0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource Desplazamiento.Pulgar}"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Desplazamiento.Pulgar}"/>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================
         Etiqueta de estado de un alojamiento (Libre, Ocupada...)
         ============================================================ -->

    <Style x:Key="Chip.Estado" TargetType="Border">
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="{StaticResource Pincel.Salvia100}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Estado}" Value="Ocupado">
                <Setter Property="Background" Value="{StaticResource Pincel.ErrorFondo}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Estado}" Value="EnReparacion">
                <Setter Property="Background" Value="{StaticResource Pincel.AvisoFondo}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Estado}" Value="PendienteLimpieza">
                <Setter Property="Background" Value="#F6EFC9"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Chip.EstadoTexto" TargetType="TextBlock" BasedOn="{StaticResource Texto.Base}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="Foreground" Value="{StaticResource Pincel.Bosque700}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Estado}" Value="Ocupado">
                <Setter Property="Foreground" Value="{StaticResource Pincel.Error}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Estado}" Value="EnReparacion">
                <Setter Property="Foreground" Value="{StaticResource Pincel.Aviso}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Estado}" Value="PendienteLimpieza">
                <Setter Property="Foreground" Value="#8A6D12"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
