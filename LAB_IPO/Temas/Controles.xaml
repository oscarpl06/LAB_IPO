<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:comp="clr-namespace:LAB_IPO.Componentes">

    <!-- ============================================================
         Ventana con marco propio (barra de título Nature Premium)
         ============================================================ -->

    <Style x:Key="Boton.Ventana" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Foreground" Value="{StaticResource Pincel.TextoSecundario}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource Fuente.Iconos}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Arena200}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Arena300}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Boton.VentanaCerrar" TargetType="Button" BasedOn="{StaticResource Boton.Ventana}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}">
                        <ContentPresenter x:Name="Contenido" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#C42B1C"/>
                            <Setter TargetName="Contenido" Property="TextElement.Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#A3261A"/>
                            <Setter TargetName="Contenido" Property="TextElement.Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ventana.Natural" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Pincel.BlancoCalido}"/>
        <Setter Property="Foreground" Value="{StaticResource Pincel.TextoPrincipal}"/>
        <Setter Property="FontFamily" Value="{StaticResource Fuente.Texto}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0"
                              GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border x:Name="Marco" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Pincel.BordeFuerte}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Barra de título -->
                            <DockPanel Grid.Row="0" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="BtnMinimizar" Style="{StaticResource Boton.Ventana}"
                                            Content="{StaticResource Icono.Minimizar}" ToolTip="Minimizar"
                                            Command="{x:Static SystemCommands.MinimizeWindowCommand}"/>
                                    <Button x:Name="BtnMaximizar" Style="{StaticResource Boton.Ventana}"
                                            Content="{StaticResource Icono.Maximizar}" ToolTip="Maximizar"
                                            Command="{x:Static SystemCommands.MaximizeWindowCommand}"/>
                                    <Button x:Name="BtnRestaurar" Style="{StaticResource Boton.Ventana}"
                                            Content="{StaticResource Icono.Restaurar}" ToolTip="Restaurar"
                                            Visibility="Collapsed"
                                            Command="{x:Static SystemCommands.RestoreWindowCommand}"/>
                                    <Button Style="{StaticResource Boton.VentanaCerrar}"
                                            Content="{StaticResource Icono.Cerrar}" ToolTip="Cerrar"
                                            Command="{x:Static SystemCommands.CloseWindowCommand}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <Image Source="/LAB_IPO;component/Recursos/Imagenes/logo-insignia.png"
                                           Width="18" Height="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="{TemplateBinding Title}" FontSize="12"
                                               Foreground="{StaticResource Pincel.TextoSecundario}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>

                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter/>
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="Marco" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="Marco" Property="Padding" Value="7"/>
                            <Setter TargetName="BtnMaximizar" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="BtnRestaurar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="BtnMaximizar" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="BtnMinimizar" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="BtnMaximizar" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource Pincel.Borde}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Botones
         ============================================================ -->

    <Style x:Key="Boton.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Fuente.Texto}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Acción principal: verde bosque relleno -->
    <Style x:Key="Boton.Primario" TargetType="Button" BasedOn="{StaticResource Boton.Base}">
        <Setter Property="Foreground" Value="{StaticResource Pincel.Blanco}"/>
        <Setter Property="Background" Value="{StaticResource Pincel.Bosque700}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fondo" CornerRadius="10" Background="{TemplateBinding Background}"
                                Effect="{StaticResource Sombra.Boton}"/>
                        <Border x:Name="Foco" CornerRadius="12" Margin="-3" BorderThickness="2"
                                BorderBrush="{StaticResource Pincel.Salvia500}" Visibility="Collapsed"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Bosque600}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Bosque800}"/>
                            <Setter TargetName="Fondo" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Foco" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Salvia200}"/>
                            <Setter TargetName="Fondo" Property="Effect" Value="{x:Null}"/>
                            <Setter Property="Foreground" Value="{StaticResource Pincel.TextoTenue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Acción secundaria: contorno sobre fondo claro -->
    <Style x:Key="Boton.Secundario" TargetType="Button" BasedOn="{StaticResource Boton.Base}">
        <Setter Property="Foreground" Value="{StaticResource Pincel.Bosque800}"/>
        <Setter Property="Background" Value="{StaticResource Pincel.Blanco}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Pincel.BordeFuerte}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fondo" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                        <Border x:Name="Foco" CornerRadius="12" Margin="-3" BorderThickness="2"
                                BorderBrush="{StaticResource Pincel.Salvia500}" Visibility="Collapsed"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Beige100}"/>
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Pincel.Bosque600}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Arena200}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Foco" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Pincel.TextoTenue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Variante compacta para cabeceras y barras -->
    <Style x:Key="Boton.SecundarioPequeno" TargetType="Button" BasedOn="{StaticResource Boton.Secundario}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="16,0"/>
    </Style>

    <!-- Enlace de texto -->
    <Style x:Key="Boton.Enlace" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Pincel.Bosque600}"/>
        <Setter Property="FontFamily" Value="{StaticResource Fuente.Texto}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="Transparent" CornerRadius="4" Padding="2,1">
                        <TextBlock x:Name="Texto" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Texto" Property="TextDecorations" Value="Underline"/>
                            <Setter TargetName="Texto" Property="Foreground" Value="{StaticResource Pincel.Bosque800}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Salvia100}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Opción del menú lateral: seleccionada con fondo salvia y barra de acento -->
    <Style x:Key="Boton.Menu" TargetType="RadioButton">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="FontFamily" Value="{StaticResource Fuente.Texto}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Pincel.TextoPrincipal}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Fondo" CornerRadius="8" Background="Transparent">
                        <Grid>
                            <Border x:Name="Acento" Width="3" Height="16" CornerRadius="2"
                                    HorizontalAlignment="Left" Margin="4,0,0,0"
                                    Background="{StaticResource Pincel.Bosque700}" Visibility="Collapsed"/>
                            <ContentPresenter x:Name="Contenido" Margin="16,0,8,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Beige100}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Salvia100}"/>
                            <Setter TargetName="Acento" Property="Visibility" Value="Visible"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource Pincel.Bosque800}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Pincel.Salvia500}"/>
                            <Setter TargetName="Fondo" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Pincel.TextoTenue}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón de ojo para mostrar u ocultar la clave (dentro del campo) -->
    <Style x:Key="Boton.VerClave" TargetType="ToggleButton">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource Pincel.TextoSecundario}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Fondo" CornerRadius="6" Background="Transparent">
                        <TextBlock x:Name="Glifo" Style="{StaticResource Icono}" FontSize="16"
                                   Text="{StaticResource Icono.Ver}" Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glifo" Property="Text" Value="{StaticResource Icono.Ocultar}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Salvia100}"/>
                            <Setter TargetName="Glifo" Property="Foreground" Value="{StaticResource Pincel.Bosque700}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Salvia200}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Campos de texto
         ============================================================ -->

    <Style x:Key="Campo.Texto" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Fuente.Texto}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Pincel.TextoPrincipal}"/>
        <Setter Property="Background" Value="{StaticResource Pincel.Blanco}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Pincel.Borde}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Pincel.Bosque700}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Pincel.Salvia500}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Borde" CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="Ejemplo" Text="{TemplateBinding comp:CampoAyudante.TextoEjemplo}"
                                       Foreground="{StaticResource Pincel.TextoTenue}" IsHitTestVisible="False"
                                       Margin="14,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center" Focusable="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Ejemplo" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Pincel.BordeFuerte}"/>
                        </Trigger>
                        <Trigger Property="comp:CampoAyudante.TieneError" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Pincel.Error}"/>
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Pincel.ErrorFondo}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Pincel.Bosque600}"/>
                            <Setter TargetName="Borde" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Pincel.Blanco}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Pincel.Beige100}"/>
                            <Setter Property="Foreground" Value="{StaticResource Pincel.TextoTenue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Campo.Clave" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource Fuente.Texto}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Pincel.TextoPrincipal}"/>
        <Setter Property="Background" Value="{StaticResource Pincel.Blanco}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Pincel.Borde}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Pincel.Bosque700}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Pincel.Salvia500}"/>
        <Setter Property="PasswordChar" Value="●"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="comp:CampoAyudante.VigilarClave" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Borde" CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="Ejemplo" Text="{TemplateBinding comp:CampoAyudante.TextoEjemplo}"
                                       Foreground="{StaticResource Pincel.TextoTenue}" IsHitTestVisible="False"
                                       Margin="14,0" VerticalAlignment="Center"/>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center" Focusable="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="comp:CampoAyudante.TieneTexto" Value="True">
                            <Setter TargetName="Ejemplo" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Pincel.BordeFuerte}"/>
                        </Trigger>
                        <Trigger Property="comp:CampoAyudante.TieneError" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Pincel.Error}"/>
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Pincel.ErrorFondo}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Pincel.Bosque600}"/>
                            <Setter TargetName="Borde" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Pincel.Blanco}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Tarjetas, separadores y ayudas
         ============================================================ -->

    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Pincel.Blanco}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Pincel.Borde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Effect" Value="{StaticResource Sombra.Tarjeta}"/>
    </Style>

    <Style x:Key="Separador" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Pincel.Borde}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Tooltip con el mismo lenguaje visual (ayuda sensible al contexto) -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource Fuente.Texto}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Pincel.Blanco}"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Pincel.Bosque800}" CornerRadius="6" Padding="10,6"
                            MaxWidth="320" Margin="6" Effect="{StaticResource Sombra.Tarjeta}">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
