<UserControl x:Class="LAB_IPO.Componentes.AvatarUsuario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="36" Height="36">
    <Grid>
        <!-- Sin foto: iniciales sobre círculo salvia -->
        <Ellipse Fill="{StaticResource Pincel.Salvia200}" Stroke="{StaticResource Pincel.Blanco}" StrokeThickness="2"/>
        <TextBlock x:Name="TxtIniciales" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontFamily="{StaticResource Fuente.Titulos}" FontWeight="SemiBold"
                   Foreground="{StaticResource Pincel.Bosque800}"/>
        <!-- Con foto: la foto recortada en círculo -->
        <Ellipse x:Name="CirculoFoto" Stroke="{StaticResource Pincel.Blanco}" StrokeThickness="2" Visibility="Collapsed">
            <Ellipse.Fill>
                <ImageBrush x:Name="PincelFoto" Stretch="UniformToFill"/>
            </Ellipse.Fill>
        </Ellipse>
    </Grid>
</UserControl>
