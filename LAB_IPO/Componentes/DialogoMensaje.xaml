<comp:VentanaBase x:Class="LAB_IPO.Componentes.DialogoMensaje"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:comp="clr-namespace:LAB_IPO.Componentes"
                  Title="Camping Timoteo"
                  Width="460" SizeToContent="Height"
                  ResizeMode="NoResize" ShowInTaskbar="False"
                  WindowStartupLocation="CenterOwner">

    <Grid Margin="28,8,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Icono del tipo de mensaje -->
        <Border x:Name="FondoIcono" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top"
                Background="{StaticResource Pincel.InfoFondo}">
            <TextBlock x:Name="TxtIcono" Style="{StaticResource Icono}" FontSize="20"
                       Text="{StaticResource Icono.Info}" Foreground="{StaticResource Pincel.Info}"/>
        </Border>

        <StackPanel Grid.Column="1" Margin="18,2,0,0">
            <TextBlock x:Name="TxtTitulo" Style="{StaticResource Texto.TituloDialogo}"/>
            <TextBlock x:Name="TxtMensaje" Style="{StaticResource Texto.Secundario}" FontSize="14"
                       Margin="0,8,0,0" LineHeight="21"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,28,0,0">
            <Button x:Name="BtnCancelar" Style="{StaticResource Boton.Secundario}" Content="Cancelar"
                    MinWidth="110" Margin="0,0,12,0" IsCancel="True" Visibility="Collapsed"
                    Click="Cancelar_Click"/>
            <Button x:Name="BtnAceptar" Style="{StaticResource Boton.Primario}" Content="Aceptar"
                    MinWidth="110" IsDefault="True" Click="Aceptar_Click"/>
        </StackPanel>
    </Grid>
</comp:VentanaBase>
