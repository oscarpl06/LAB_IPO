<UserControl x:Class="LAB_IPO.Componentes.CampoClave"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:LAB_IPO.Componentes"
             x:Name="Raiz" Height="40">

    <!--
        Campo de clave con un botón de ojo para mostrarla u ocultarla.
        La clave oculta va en un PasswordBox y la visible en un TextBox;
        los dos se mantienen sincronizados y solo se ve uno cada vez.
    -->
    <Grid>
        <PasswordBox x:Name="CajaClave" Style="{StaticResource Campo.Clave}"
                     Height="{Binding ActualHeight, ElementName=Raiz}" Padding="12,0,46,0"
                     comp:CampoAyudante.TextoEjemplo="{Binding (comp:CampoAyudante.TextoEjemplo), ElementName=Raiz}"
                     comp:CampoAyudante.TieneError="{Binding (comp:CampoAyudante.TieneError), ElementName=Raiz}"
                     ToolTip="{Binding ToolTip, ElementName=Raiz}"
                     PasswordChanged="CajaClave_PasswordChanged"/>

        <TextBox x:Name="CajaClaveVisible" Style="{StaticResource Campo.Texto}" Visibility="Collapsed"
                 Height="{Binding ActualHeight, ElementName=Raiz}" Padding="12,0,46,0"
                 comp:CampoAyudante.TextoEjemplo="{Binding (comp:CampoAyudante.TextoEjemplo), ElementName=Raiz}"
                 comp:CampoAyudante.TieneError="{Binding (comp:CampoAyudante.TieneError), ElementName=Raiz}"
                 ToolTip="{Binding ToolTip, ElementName=Raiz}"
                 TextChanged="CajaClaveVisible_TextChanged"/>

        <ToggleButton x:Name="BtnVerClave" Style="{StaticResource Boton.VerClave}"
                      HorizontalAlignment="Right" Margin="0,0,6,0"
                      ToolTip="Mostrar la clave"
                      Checked="BtnVerClave_Cambiado" Unchecked="BtnVerClave_Cambiado"/>
    </Grid>
</UserControl>
