<comp:VentanaBase x:Class="LAB_IPO.Vistas.VentanaLogin"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:comp="clr-namespace:LAB_IPO.Componentes"
                  Title="Camping Timoteo  ·  Iniciar sesión"
                  Width="1240" Height="790" MinWidth="1040" MinHeight="720"
                  WindowStartupLocation="CenterScreen"
                  Icon="/LAB_IPO;component/Recursos/app.ico"
                  FocusManager.FocusedElement="{Binding ElementName=TxtUsuario}">

    <!-- PG1 · Login: panel de marca a la izquierda y formulario de acceso a la derecha -->
    <Grid Margin="12,0,12,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="560"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Panel izquierdo: marca y bienvenida ===== -->
        <Border Grid.Column="0" CornerRadius="18" Background="{StaticResource Pincel.PanelMarca}"
                BorderBrush="{StaticResource Pincel.Arena400}" BorderThickness="1">
            <Grid Margin="40,26,40,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logotipo + rótulo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Image Source="/LAB_IPO;component/Recursos/Imagenes/logo-texto.png"
                           Width="148" Height="83" Stretch="Uniform"/>
                    <TextBlock Text="GESTIÓN DEL CAMPING" Style="{StaticResource Texto.Rotulo}"
                               Margin="36,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Bienvenida -->
                <StackPanel Grid.Row="2" Margin="28,0,0,0">
                    <TextBlock Text="Bienvenido de nuevo" Style="{StaticResource Texto.Display}"/>
                    <TextBlock Text="Inicia sesión para gestionar el camping"
                               Style="{StaticResource Texto.Subtitulo}" Margin="0,10,0,0"/>
                    <Image Source="/LAB_IPO;component/Recursos/Imagenes/logo-insignia.png"
                           Width="311" Height="218" Stretch="Uniform" HorizontalAlignment="Left"
                           Margin="0,22,0,0"/>
                </StackPanel>

                <!-- Pie: versión -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="8,0,0,0">
                    <Border Style="{StaticResource Separador}" Width="200" Background="{StaticResource Pincel.Arena400}"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="Versión 0.1.0  |  2026" Style="{StaticResource Texto.Nota}"
                               Margin="20,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Panel derecho: formulario de acceso ===== -->
        <Grid Grid.Column="1">
            <!-- Icono de usuario (esquina superior derecha) -->
            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource Pincel.Salvia100}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,54,0">
                <TextBlock Style="{StaticResource Icono}" Text="{StaticResource Icono.Usuario}" FontSize="18"
                           Foreground="{StaticResource Pincel.Bosque700}"/>
            </Border>

            <StackPanel Width="500" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Iniciar sesión" Style="{StaticResource Texto.Titulo}"/>
                <TextBlock Text="Introduce tu identificación y tu clave"
                           Style="{StaticResource Texto.Secundario}" FontSize="14" Margin="0,8,0,0"/>

                <!-- Usuario -->
                <TextBlock Style="{StaticResource Texto.Etiqueta}" Margin="0,44,0,8">
                    <Run Text="Usuario"/>
                    <Run Text="*" Foreground="{StaticResource Pincel.Error}"/>
                </TextBlock>
                <TextBox x:Name="TxtUsuario" Style="{StaticResource Campo.Texto}"
                         comp:CampoAyudante.TextoEjemplo="Identificación (ej. federico.g)"
                         ToolTip="Tu identificación de acceso a la aplicación, por ejemplo federico.g"
                         TextChanged="Campo_Cambiado"/>

                <!-- Clave -->
                <TextBlock Style="{StaticResource Texto.Etiqueta}" Margin="0,22,0,8">
                    <Run Text="Clave"/>
                    <Run Text="*" Foreground="{StaticResource Pincel.Error}"/>
                </TextBlock>
                <comp:CampoClave x:Name="TxtClave"
                                 comp:CampoAyudante.TextoEjemplo="Introduce tu clave"
                                 ToolTip="Clave personal asociada a tu usuario. Distingue mayúsculas y minúsculas."
                                 PasswordChanged="Campo_Cambiado"/>

                <!-- ¿Has olvidado la contraseña? -->
                <Button Style="{StaticResource Boton.Enlace}" Content="¿Has olvidado la contraseña?"
                        HorizontalAlignment="Right" Margin="0,8,0,0"
                        ToolTip="Cómo recuperar el acceso si no recuerdas tu clave"
                        Click="ClaveOlvidada_Click"/>

                <!-- Mensaje de error (reserva su hueco para que el formulario no salte) -->
                <StackPanel x:Name="PanelError" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Hidden">
                    <TextBlock Style="{StaticResource Icono}" Text="{StaticResource Icono.Error}" FontSize="14"
                               Foreground="{StaticResource Pincel.Error}"/>
                    <TextBlock x:Name="TxtError" Style="{StaticResource Texto.Base}" FontSize="13"
                               Foreground="{StaticResource Pincel.Error}" Margin="8,0,0,0"
                               Text="Usuario o clave incorrectos. Inténtalo de nuevo."/>
                </StackPanel>

                <!-- Acciones -->
                <Button x:Name="BtnEntrar" Style="{StaticResource Boton.Primario}" Content="Entrar"
                        Height="46" FontSize="15" Margin="0,22,0,0" IsDefault="True"
                        ToolTip="Accede a la gestión del camping (Intro)"
                        Click="Entrar_Click"/>
                <Button Style="{StaticResource Boton.Secundario}" Content="Salir"
                        Height="38" Margin="0,14,0,0"
                        ToolTip="Cierra la aplicación"
                        Click="Salir_Click"/>

                <Border Style="{StaticResource Separador}" Margin="0,32,0,0"/>

                <!-- Ayuda -->
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource Pincel.Salvia100}">
                        <TextBlock Style="{StaticResource Icono}" Text="{StaticResource Icono.Ayuda}" FontSize="15"
                                   Foreground="{StaticResource Pincel.Bosque700}"/>
                    </Border>
                    <TextBlock Style="{StaticResource Texto.Nota}" Margin="12,0,0,0" VerticalAlignment="Center"
                               Text="Pulsa F1 para ver la ayuda. Deja el cursor sobre un campo para ver su descripción."/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</comp:VentanaBase>
