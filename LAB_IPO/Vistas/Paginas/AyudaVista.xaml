<comp:VistaSecundaria x:Class="LAB_IPO.Vistas.Paginas.AyudaVista"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:comp="clr-namespace:LAB_IPO.Componentes">

    <comp:VistaSecundaria.Resources>
        <!-- Tema del índice: texto alineado a la izquierda, marcado con fondo salvia y acento -->
        <Style x:Key="Tema" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource Fuente.Texto}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Pincel.TextoPrincipal}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Fondo" CornerRadius="8" Background="Transparent" Padding="14,8">
                            <Grid>
                                <Border x:Name="Acento" Width="3" HorizontalAlignment="Left" Margin="-10,0,0,0"
                                        CornerRadius="2" Background="{StaticResource Pincel.Bosque700}" Visibility="Collapsed"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Beige100}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Beige100}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Salvia100}"/>
                                <Setter TargetName="Acento" Property="Visibility" Value="Visible"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource Pincel.Bosque800}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </comp:VistaSecundaria.Resources>

    <!-- PG14 · Centro de ayuda (CU-29) -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Centro de ayuda" Style="{StaticResource Texto.TituloSeccion}"/>
            <TextBlock Text="Encuentra instrucciones rápidas para las tareas habituales de gestión."
                       Style="{StaticResource Texto.Secundario}" Margin="0,6,0,0"/>
            <Border Style="{StaticResource Separador}" Margin="0,14,0,14"/>
        </StackPanel>

        <!-- Pie: volver al trabajo en curso y contacto con soporte -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="BtnVolver" Style="{StaticResource Boton.Secundario}" HorizontalAlignment="Left" MinWidth="160"
                    Click="Volver_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icono}" Text="&#xE72B;" FontSize="13" Margin="0,0,8,0"
                               Foreground="{StaticResource Pincel.Bosque800}"/>
                    <TextBlock x:Name="TxtVolver" Text="Volver"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnSoporte" Style="{StaticResource Boton.Primario}" HorizontalAlignment="Right" MinWidth="220"
                    ToolTip="Ver cómo contactar con el soporte técnico de la aplicación" Click="Soporte_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icono}" Text="&#xE717;" FontSize="14" Margin="0,0,8,0"
                               Foreground="{StaticResource Pincel.Blanco}"/>
                    <TextBlock Text="Contactar con soporte"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Índice por temas con búsqueda -->
            <Border Style="{StaticResource Tarjeta}" Padding="18,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="ÍNDICE POR TEMAS" Style="{StaticResource Texto.Rotulo}"/>
                        <Grid Margin="0,12,0,10">
                            <TextBox x:Name="TxtBuscar" Style="{StaticResource Campo.Texto}" Height="36" Padding="12,0,34,0"
                                     comp:CampoAyudante.TextoEjemplo="Buscar en la ayuda..."
                                     ToolTip="Escribe una palabra (por ejemplo, «cancelar») para filtrar los temas"
                                     TextChanged="Buscar_TextChanged"/>
                            <TextBlock Style="{StaticResource Icono}" Text="&#xE721;" FontSize="13" Margin="0,0,12,0"
                                       HorizontalAlignment="Right" IsHitTestVisible="False"
                                       Foreground="{StaticResource Pincel.TextoTenue}"/>
                        </Grid>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <StackPanel x:Name="Indice"/>
                            <TextBlock x:Name="TxtSinTemas" Style="{StaticResource Texto.Nota}" TextWrapping="Wrap"
                                       Margin="4,8,0,0" Visibility="Collapsed"
                                       Text="No hay temas que coincidan con la búsqueda. Prueba con otra palabra."/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Tema seleccionado -->
            <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Padding="26,22">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <TextBlock x:Name="TxtGrupo" Style="{StaticResource Texto.Rotulo}"/>
                        <TextBlock x:Name="TxtEncabezado" Style="{StaticResource Texto.TituloSeccion}" FontSize="22"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock x:Name="TxtIntroduccion" Style="{StaticResource Texto.Secundario}" FontSize="14"
                                   TextWrapping="Wrap" Margin="0,10,0,14"/>

                        <ItemsControl x:Name="ListaPasos">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="14" VerticalAlignment="Top"
                                                Background="{StaticResource Pincel.Salvia100}">
                                            <TextBlock Text="{Binding Numero}" FontWeight="SemiBold" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Pincel.Bosque800}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Texto}" Style="{StaticResource Texto.Base}"
                                                   FontSize="14" TextWrapping="Wrap" Margin="12,4,0,0" LineHeight="21"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Avisos generales del boceto -->
                        <Border Background="{StaticResource Pincel.AvisoFondo}" CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icono}" Text="{StaticResource Icono.Aviso}"
                                           FontSize="14" Foreground="{StaticResource Pincel.Aviso}" VerticalAlignment="Top"
                                           Margin="0,1,10,0"/>
                                <TextBlock Style="{StaticResource Texto.Base}" TextWrapping="Wrap"
                                           Text="Antes de cancelar o eliminar información, confirma la acción en el cuadro de diálogo."/>
                            </DockPanel>
                        </Border>
                        <Border Background="{StaticResource Pincel.Salvia100}" CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icono}" Text="{StaticResource Icono.Info}"
                                           FontSize="14" Foreground="{StaticResource Pincel.Bosque700}" VerticalAlignment="Top"
                                           Margin="0,1,10,0"/>
                                <TextBlock Style="{StaticResource Texto.Base}" TextWrapping="Wrap"
                                           Foreground="{StaticResource Pincel.Bosque800}"
                                           Text="Consejo: pasa el cursor sobre los campos para consultar su ayuda contextual. Pulsa F1 en cualquier pantalla para abrir su tema de ayuda."/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</comp:VistaSecundaria>
