<comp:VistaBase x:Class="LAB_IPO.Vistas.Paginas.FormularioActividadVista"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:comp="clr-namespace:LAB_IPO.Componentes">

    <comp:VistaBase.Resources>
        <Style x:Key="Etiqueta.Campo" TargetType="TextBlock" BasedOn="{StaticResource Texto.Etiqueta}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="104"/>
        </Style>

        <!-- Día de la semana: botón redondo que se activa y desactiva -->
        <Style x:Key="Boton.Dia" TargetType="ToggleButton">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource Fuente.Texto}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Pincel.TextoSecundario}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Fondo" CornerRadius="19" Background="{StaticResource Pincel.Blanco}"
                                    BorderBrush="{StaticResource Pincel.Borde}" BorderThickness="1"/>
                            <Border x:Name="Foco" CornerRadius="22" Margin="-3" BorderThickness="2"
                                    BorderBrush="{StaticResource Pincel.Salvia500}" Visibility="Collapsed"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Pincel.Bosque600}"/>
                                <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Beige100}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Foco" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Bosque700}"/>
                                <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Pincel.Bosque700}"/>
                                <Setter Property="Foreground" Value="{StaticResource Pincel.Blanco}"/>
                            </Trigger>
                            <Trigger Property="comp:CampoAyudante.TieneError" Value="True">
                                <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Pincel.Error}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </comp:VistaBase.Resources>

    <!-- PG13b · Nueva actividad (CU-24) -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TxtTitulo" Text="Nueva actividad" Style="{StaticResource Texto.TituloSeccion}"/>
            <TextBlock x:Name="TxtSubtitulo" Text="Configura la actividad, su horario, plazas y área del camping."
                       Style="{StaticResource Texto.Secundario}" Margin="0,6,0,0"/>
            <Border Style="{StaticResource Separador}" Margin="0,14,0,12"/>
        </StackPanel>

        <!-- Pie: errores y botones -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <StackPanel x:Name="NotaMonitores" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icono}" Text="{StaticResource Icono.Info}" FontSize="13"
                               Foreground="{StaticResource Pincel.Info}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Texto.Nota}" VerticalAlignment="Center"
                               x:Name="TxtNotaMonitores"
                               Text="Los monitores responsables se asignan después, desde el listado de actividades."/>
                </StackPanel>
                <Border x:Name="PanelError" Background="{StaticResource Pincel.ErrorFondo}" CornerRadius="10"
                        Padding="12,8" Margin="0,0,20,0" VerticalAlignment="Center" Visibility="Hidden">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icono}" Text="{StaticResource Icono.Error}"
                                   FontSize="14" Foreground="{StaticResource Pincel.Error}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                        <TextBlock x:Name="TxtError" Style="{StaticResource Texto.Base}" Foreground="{StaticResource Pincel.Error}"
                                   TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnCancelarFormulario" Style="{StaticResource Boton.Secundario}" Content="Cancelar"
                        MinWidth="120" Margin="0,0,12,0" ToolTip="Volver al listado sin guardar" Click="Cancelar_Click"/>
                <Button x:Name="BtnGuardar" Style="{StaticResource Boton.Primario}" MinWidth="190"
                        ToolTip="Registrar la actividad con los datos indicados" Click="Guardar_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icono}" Text="&#xE74E;" FontSize="14" Margin="0,0,8,0"
                                   Foreground="{StaticResource Pincel.Blanco}"/>
                        <TextBlock x:Name="TxtGuardar" Text="Guardar actividad"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,6,0">
            <StackPanel Margin="0,0,0,8">

                <!-- Información general -->
                <GroupBox Style="{StaticResource Grupo}" Header="Información general">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Etiqueta.Campo}">
                                <Run Text="Nombre"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                            </TextBlock>
                            <TextBox x:Name="TxtNombre" Grid.Column="1" Style="{StaticResource Campo.Texto}" MaxLength="60"
                                     comp:CampoAyudante.TextoEjemplo="Ej. Taller de naturaleza"
                                     ToolTip="Nombre con el que se anunciará la actividad"
                                     TextChanged="Campo_Cambiado"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center"
                                       Margin="30,0,12,0">
                                <Run Text="Público"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                            </TextBlock>
                            <ComboBox x:Name="CmbPublico" Grid.Column="3" Style="{StaticResource Campo.Desplegable}"
                                      comp:CampoAyudante.TextoEjemplo="Niños / Adultos / Familiar"
                                      ToolTip="Destinatarios de la actividad" SelectionChanged="Campo_Cambiado"/>
                        </Grid>
                        <DockPanel Margin="0,14,0,0">
                            <TextBlock Text="Descripción" Style="{StaticResource Etiqueta.Campo}" VerticalAlignment="Top"
                                       Margin="0,10,0,0"/>
                            <TextBox x:Name="TxtDescripcion" Style="{StaticResource Campo.TextoLargo}" MinHeight="64"
                                     MaxLength="400"
                                     comp:CampoAyudante.TextoEjemplo="Explica en qué consiste la actividad y qué deben traer los participantes."
                                     ToolTip="Descripción que verán los clientes (opcional)"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Horario y cupo -->
                    <GroupBox Style="{StaticResource Grupo}" Header="Horario y cupo">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Etiqueta.Campo}">
                                    <Run Text="Día/s"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                                </TextBlock>
                                <StackPanel x:Name="PanelDias" Orientation="Horizontal"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="104,6,0,0">
                                <Button Style="{StaticResource Boton.Enlace}" Content="De lunes a viernes" Margin="0,0,16,0"
                                        ToolTip="Marcar de lunes a viernes" Click="DiasLaborables_Click"/>
                                <Button Style="{StaticResource Boton.Enlace}" Content="Fin de semana" Margin="0,0,16,0"
                                        ToolTip="Marcar sábado y domingo" Click="FinDeSemana_Click"/>
                                <Button Style="{StaticResource Boton.Enlace}" Content="Todos"
                                        ToolTip="Marcar todos los días" Click="TodosLosDias_Click"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource Etiqueta.Campo}">
                                    <Run Text="Hora inicio"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                                </TextBlock>
                                <TextBox x:Name="TxtHoraInicio" Style="{StaticResource Campo.Texto}" Width="90" MaxLength="5"
                                         comp:CampoAyudante.TextoEjemplo="10:00"
                                         ToolTip="Hora de comienzo con el formato hh:mm (de 07:00 a 23:00)"
                                         TextChanged="Campo_Cambiado"/>
                                <TextBlock Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="24,0,12,0">
                                    <Run Text="Hora fin"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                                </TextBlock>
                                <TextBox x:Name="TxtHoraFin" Style="{StaticResource Campo.Texto}" Width="90" MaxLength="5"
                                         comp:CampoAyudante.TextoEjemplo="11:30"
                                         ToolTip="Hora de finalización con el formato hh:mm; debe ser posterior al inicio"
                                         TextChanged="Campo_Cambiado"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="Cupo mínimo" Style="{StaticResource Etiqueta.Campo}"/>
                                <TextBox x:Name="TxtCupoMinimo" Style="{StaticResource Campo.Texto}" Width="90" MaxLength="3"
                                         comp:CampoAyudante.TextoEjemplo="4"
                                         ToolTip="Participantes necesarios para que se haga la actividad (opcional)"
                                         PreviewTextInput="SoloNumeros" TextChanged="Campo_Cambiado"/>
                                <TextBlock Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="24,0,12,0">
                                    <Run Text="Cupo máximo"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                                </TextBlock>
                                <TextBox x:Name="TxtCupoMaximo" Style="{StaticResource Campo.Texto}" Width="90" MaxLength="3"
                                         comp:CampoAyudante.TextoEjemplo="12"
                                         ToolTip="Número máximo de plazas (mayor que cero)"
                                         PreviewTextInput="SoloNumeros" TextChanged="Campo_Cambiado"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="Precio" Style="{StaticResource Etiqueta.Campo}"/>
                                <Grid Width="110">
                                    <TextBox x:Name="TxtPrecio" Style="{StaticResource Campo.Texto}" MaxLength="7"
                                             Padding="12,0,30,0" comp:CampoAyudante.TextoEjemplo="8,00"
                                             ToolTip="Precio en euros; déjalo vacío si la actividad es gratuita"
                                             PreviewTextInput="SoloImporte" TextChanged="Precio_Cambiado"/>
                                    <TextBlock Text="€" Style="{StaticResource Texto.Secundario}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                                </Grid>
                                <ComboBox x:Name="CmbUnidadPrecio" Style="{StaticResource Campo.Desplegable}" Width="170"
                                          Margin="10,0,0,0" ToolTip="Si el precio es por persona, por hora o por mes"
                                          SelectionChanged="Campo_Cambiado"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Lugar y material -->
                    <GroupBox Grid.Column="2" Style="{StaticResource Grupo}" Header="Lugar y material">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Etiqueta.Campo}">
                                    <Run Text="Área"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                                </TextBlock>
                                <ComboBox x:Name="CmbArea" Style="{StaticResource Campo.Desplegable}" Width="250"
                                          comp:CampoAyudante.TextoEjemplo="Piscina / Pradera / Playa / Sala..."
                                          ToolTip="Zona del camping donde se realiza la actividad"
                                          SelectionChanged="Campo_Cambiado"/>
                            </StackPanel>
                            <DockPanel Margin="0,14,0,0">
                                <TextBlock Text="Materiales" Style="{StaticResource Etiqueta.Campo}" VerticalAlignment="Top"
                                           Margin="0,10,0,0"/>
                                <TextBox x:Name="TxtMateriales" Style="{StaticResource Campo.TextoLargo}" MinHeight="88"
                                         MaxLength="300"
                                         comp:CampoAyudante.TextoEjemplo="Conos, botiquín, material didáctico..."
                                         ToolTip="Materiales o equipamiento necesarios (opcional)"/>
                            </DockPanel>
                            <DockPanel Margin="0,14,0,0">
                                <TextBlock Text="Notas" Style="{StaticResource Etiqueta.Campo}"/>
                                <TextBox x:Name="TxtNotas" Style="{StaticResource Campo.Texto}" MaxLength="150"
                                         comp:CampoAyudante.TextoEjemplo="Información adicional"
                                         ToolTip="Información adicional para el personal (opcional)"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</comp:VistaBase>
