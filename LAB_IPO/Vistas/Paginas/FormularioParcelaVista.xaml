<comp:VistaBase x:Class="LAB_IPO.Vistas.Paginas.FormularioParcelaVista"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:comp="clr-namespace:LAB_IPO.Componentes">

    <!-- PG4 · Formulario de parcela (alta) -->
    <DockPanel>
        <!-- Cabecera -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TxtTitulo" Text="Nueva parcela" Style="{StaticResource Texto.TituloSeccion}"/>
            <TextBlock x:Name="TxtSubtitulo" Text="Registra una parcela del camping con su tipo, tamaño, ubicación y servicios"
                       Style="{StaticResource Texto.Secundario}" Margin="0,6,0,0"/>
            <Border Style="{StaticResource Separador}" Margin="0,14,0,12"/>
        </StackPanel>

        <!-- Pie: errores y botones -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="PanelError" Background="{StaticResource Pincel.ErrorFondo}" CornerRadius="10"
                    Padding="12,8" Margin="0,0,20,0" VerticalAlignment="Center" Visibility="Hidden">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icono}" Text="{StaticResource Icono.Error}"
                               FontSize="14" Foreground="{StaticResource Pincel.Error}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                    <TextBlock x:Name="TxtError" Style="{StaticResource Texto.Base}" Foreground="{StaticResource Pincel.Error}"/>
                </DockPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnCancelarFormulario" Style="{StaticResource Boton.Secundario}" Content="Cancelar" MinWidth="120" Margin="0,0,12,0"
                        ToolTip="Volver al listado sin guardar" Click="Cancelar_Click"/>
                <Button x:Name="BtnGuardar" Style="{StaticResource Boton.Primario}" MinWidth="190"
                        ToolTip="Registrar la parcela con los datos indicados" Click="Guardar_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icono}" Text="&#xE74E;" FontSize="14" Margin="0,0,8,0"
                                   Foreground="{StaticResource Pincel.Blanco}"/>
                        <TextBlock x:Name="TxtGuardar" Text="Guardar parcela"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,6,0">
            <StackPanel Margin="0,0,0,8">

                <!-- 1. Identificación y tipo -->
                <GroupBox Style="{StaticResource Grupo}" Header="1. Identificación y tipo">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Width="104">
                                <Run Text="Identificador"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                            </TextBlock>
                            <TextBox x:Name="TxtIdentificador" Style="{StaticResource Campo.Texto}" Width="150"
                                     CharacterCasing="Upper" MaxLength="6"
                                     comp:CampoAyudante.TextoEjemplo="P-22"
                                     ToolTip="Código único de la parcela con el formato P-número, por ejemplo P-22"
                                     TextChanged="Campo_Cambiado"/>

                            <TextBlock Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="36,0,12,0">
                                <Run Text="Tipo"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                            </TextBlock>
                            <ComboBox x:Name="CmbTipo" Style="{StaticResource Campo.Desplegable}" Width="230"
                                      DisplayMemberPath="Nombre"
                                      comp:CampoAyudante.TextoEjemplo="Selecciona un tipo..."
                                      ToolTip="Categoría de la parcela; determina el precio por noche"
                                      SelectionChanged="Campo_Cambiado"/>
                            <Button Style="{StaticResource Boton.Secundario}" Content="Ver tarifas" Margin="14,0,0,0"
                                    IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Sección en desarrollo"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Texto.Nota}" Margin="0,12,0,0"
                                   Text="El precio por noche depende del tipo de parcela y de la temporada (baja, media o alta)."/>
                    </StackPanel>
                </GroupBox>

                <!-- 2. Tamaño y ubicación -->
                <GroupBox Style="{StaticResource Grupo}" Header="2. Tamaño y ubicación" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Width="104">
                                <Run Text="Tamaño (m²)"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                            </TextBlock>
                            <TextBox x:Name="TxtTamano" Style="{StaticResource Campo.Texto}" Width="120" MaxLength="4"
                                     comp:CampoAyudante.TextoEjemplo="Ej. 80"
                                     ToolTip="Superficie de la parcela en metros cuadrados (solo números)"
                                     PreviewTextInput="SoloNumeros" TextChanged="Campo_Cambiado"/>

                            <TextBlock Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="36,0,12,0">
                                <Run Text="Ubicación"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                            </TextBlock>
                            <ComboBox x:Name="CmbUbicacion" Style="{StaticResource Campo.Desplegable}" Width="330"
                                      comp:CampoAyudante.TextoEjemplo="Selecciona una ubicación..."
                                      ToolTip="Zona del camping más cercana a la parcela"
                                      SelectionChanged="Campo_Cambiado"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Texto.Nota}" Margin="0,12,0,0"
                                   Text="Cercanía a aseos, fregaderos, piscina, bar-restaurante o entrada del complejo."/>
                    </StackPanel>
                </GroupBox>

                <!-- 3. Servicios y 4. Foto -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Style="{StaticResource Grupo}" Header="3. Servicios y características">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Texto.Nota}" Margin="0,10,0,0"
                                       Text="Marca los servicios y características con los que cuenta la parcela."/>
                            <UniformGrid Columns="3" VerticalAlignment="Top" Margin="-6,0,0,0">
                                <CheckBox x:Name="ChkAgua" Style="{StaticResource Campo.Casilla}" Content="Toma de agua"
                                          ToolTip="La parcela dispone de toma de agua" Click="Campo_Cambiado"/>
                                <CheckBox x:Name="ChkLuz" Style="{StaticResource Campo.Casilla}" Content="Toma de luz"
                                          ToolTip="La parcela dispone de toma eléctrica" Click="Campo_Cambiado"/>
                                <CheckBox x:Name="ChkDesague" Style="{StaticResource Campo.Casilla}" Content="Desagüe"
                                          ToolTip="La parcela dispone de desagüe" Click="Campo_Cambiado"/>
                                <CheckBox x:Name="ChkSetos" Style="{StaticResource Campo.Casilla}" Content="Delimitada por setos"
                                          ToolTip="La parcela está separada de las vecinas por setos" Click="Campo_Cambiado"/>
                                <CheckBox x:Name="ChkSombra" Style="{StaticResource Campo.Casilla}" Content="Zona de sombra"
                                          ToolTip="La parcela tiene sombra de árboles" Click="Campo_Cambiado"/>
                            </UniformGrid>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Style="{StaticResource Grupo}" Header="4. Foto de la parcela">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Vista previa -->
                            <Grid Height="104" VerticalAlignment="Top">
                                <Border CornerRadius="10" Background="{StaticResource Pincel.Salvia100}"
                                        BorderBrush="{StaticResource Pincel.Salvia200}" BorderThickness="1">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Icono}" Text="&#xE91B;" FontSize="22"
                                                   Foreground="{StaticResource Pincel.Salvia500}"/>
                                        <TextBlock Text="Sin foto" Style="{StaticResource Texto.Nota}" FontSize="11"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="10">
                                    <Border.Background>
                                        <ImageBrush x:Name="PincelFoto" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <Button Style="{StaticResource Boton.SecundarioPequeno}" x:Name="BtnSeleccionarFoto" Content="Seleccionar foto"
                                        ToolTip="Elegir una imagen JPG o PNG del equipo" Click="SeleccionarFoto_Click"/>
                                <Button x:Name="BtnQuitarFoto" Style="{StaticResource Boton.SecundarioPequeno}"
                                        Content="Quitar foto" Margin="0,8,0,0" IsEnabled="False"
                                        ToolTip="Quitar la foto elegida" Click="QuitarFoto_Click"/>
                                <TextBlock Style="{StaticResource Texto.Nota}" FontSize="11" Margin="0,10,0,0"
                                           Text="Opcional. Formatos JPG y PNG."/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</comp:VistaBase>
