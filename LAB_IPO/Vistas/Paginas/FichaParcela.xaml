<UserControl x:Class="LAB_IPO.Vistas.Paginas.FichaParcela"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Línea de dato: etiqueta y valor -->
        <Style x:Key="Ficha.Etiqueta" TargetType="TextBlock" BasedOn="{StaticResource Texto.Nota}">
            <Setter Property="Width" Value="110"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="Ficha.Valor" TargetType="TextBlock" BasedOn="{StaticResource Texto.Base}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Width" Value="250"/>
        </Style>
    </UserControl.Resources>

    <!-- CU-06 · Ficha de la parcela (RF-04, RF-05), en el panel lateral de la ventana principal -->
    <DockPanel>
        <!-- Pie: acceso directo a la edición (CU-05) -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Pincel.Borde}" BorderThickness="0,1,0,0"
                Padding="26,14">
            <Button x:Name="BtnEditarParcela" Style="{StaticResource Boton.Primario}" HorizontalAlignment="Stretch"
                    ToolTip="Modificar los datos de esta parcela" Click="Editar_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icono}" Text="&#xE70F;" FontSize="14" Margin="0,0,8,0"
                               Foreground="{StaticResource Pincel.Blanco}"/>
                    <TextBlock Text="Editar parcela"/>
                </StackPanel>
            </Button>
        </Border>

        <!-- Cabecera -->
        <Grid DockPanel.Dock="Top" Margin="26,22,16,0">
            <StackPanel>
                <TextBlock Text="FICHA DE LA PARCELA" Style="{StaticResource Texto.Rotulo}"/>
                <TextBlock Text="{Binding Identificador, StringFormat='Parcela {0}'}"
                           Style="{StaticResource Texto.TituloSeccion}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="BtnCerrarFicha" Style="{StaticResource Boton.Ventana}" Width="36" Height="36"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Focusable="True"
                    Content="{StaticResource Icono.Cerrar}" ToolTip="Cerrar la ficha (Esc)"
                    Click="Cerrar_Click"/>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,16,0,0">
            <StackPanel Margin="26,0,26,26">
                <!-- Foto grande con el estado -->
                <Grid Height="230">
                    <Border CornerRadius="14" Background="{StaticResource Pincel.Salvia100}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icono}" Text="&#xE91B;" FontSize="30"
                                       Foreground="{StaticResource Pincel.Salvia500}"/>
                            <TextBlock Text="Esta parcela no tiene foto" Style="{StaticResource Texto.Nota}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="14">
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill"
                                        ImageSource="{Binding RutaFoto, Converter={StaticResource RutaImagen}, ConverterParameter=900}"/>
                        </Border.Background>
                    </Border>
                    <Border Style="{StaticResource Chip.Estado}" VerticalAlignment="Top" Margin="14">
                        <TextBlock Text="{Binding EstadoTexto}" Style="{StaticResource Chip.EstadoTexto}"/>
                    </Border>
                </Grid>

                <!-- Datos generales (RF-04) -->
                <TextBlock Text="Datos de la parcela" Style="{StaticResource Texto.Etiqueta}" FontSize="14"
                           Margin="0,22,0,12"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Tipo" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding Tipo.Nombre}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Tamaño" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding TamanoTexto}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Ubicación" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding Ubicacion}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Precio por noche" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding Tipo.TarifasTexto}" Style="{StaticResource Ficha.Valor}" FontWeight="Normal"/>
                </StackPanel>

                <Border Style="{StaticResource Separador}" Margin="0,20,0,18"/>

                <!-- Servicios y características (RF-05) -->
                <TextBlock Text="Servicios y características" Style="{StaticResource Texto.Etiqueta}" FontSize="14"
                           Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Servicios}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Border x:Name="Marca" Width="22" Height="22" CornerRadius="11"
                                        Background="{StaticResource Pincel.Salvia100}">
                                    <TextBlock x:Name="Glifo" Style="{StaticResource Icono}" FontSize="11"
                                               Text="{StaticResource Icono.Correcto}"
                                               Foreground="{StaticResource Pincel.Bosque700}"/>
                                </Border>
                                <TextBlock x:Name="Nombre" Text="{Binding Nombre}" Style="{StaticResource Texto.Base}"
                                           FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Disponible}" Value="False">
                                    <Setter TargetName="Marca" Property="Background" Value="{StaticResource Pincel.Beige100}"/>
                                    <Setter TargetName="Glifo" Property="Text" Value="&#xE711;"/>
                                    <Setter TargetName="Glifo" Property="Foreground" Value="{StaticResource Pincel.TextoTenue}"/>
                                    <Setter TargetName="Nombre" Property="Foreground" Value="{StaticResource Pincel.TextoTenue}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
