<comp:VistaBase x:Class="LAB_IPO.Vistas.Paginas.FormularioEmpleadoVista"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:comp="clr-namespace:LAB_IPO.Componentes">

    <!-- PG12 · Formulario de empleado (alta) -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TxtTitulo" Text="Ficha de empleado" Style="{StaticResource Texto.TituloSeccion}"/>
            <TextBlock x:Name="TxtSubtitulo" Text="Introduce los datos personales, competencias y restricciones de disponibilidad."
                       Style="{StaticResource Texto.Secundario}" Margin="0,6,0,0"/>
            <Border Style="{StaticResource Separador}" Margin="0,14,0,12"/>
        </StackPanel>

        <!-- Pie: nota, errores y botones -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtNotaObligatorios" Style="{StaticResource Texto.Nota}" VerticalAlignment="Center"
                       Text="* Campos obligatorios. La fotografía es opcional y puede cambiarse más adelante."/>
            <Border x:Name="PanelError" Background="{StaticResource Pincel.ErrorFondo}" CornerRadius="10"
                    Padding="12,8" Margin="0,0,20,0" VerticalAlignment="Center" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icono}" Text="{StaticResource Icono.Error}"
                               FontSize="14" Foreground="{StaticResource Pincel.Error}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                    <TextBlock x:Name="TxtError" Style="{StaticResource Texto.Base}" Foreground="{StaticResource Pincel.Error}"/>
                </DockPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnCancelarFormulario" Style="{StaticResource Boton.Secundario}" Content="Cancelar"
                        MinWidth="120" Margin="0,0,12,0"
                        ToolTip="Volver al listado de personal sin guardar" Click="Cancelar_Click"/>
                <Button x:Name="BtnGuardar" Style="{StaticResource Boton.Primario}" MinWidth="200"
                        ToolTip="Dar de alta al empleado con los datos indicados" Click="Guardar_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icono}" Text="&#xE74E;" FontSize="14" Margin="0,0,8,0"
                                   Foreground="{StaticResource Pincel.Blanco}"/>
                        <TextBlock x:Name="TxtGuardar" Text="Guardar empleado"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,6,0">
            <StackPanel Margin="0,0,0,8">

                <!-- Datos personales -->
                <GroupBox Style="{StaticResource Grupo}" Header="Datos personales">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center">
                            <Run Text="Nombre"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                        </TextBlock>
                        <TextBox x:Name="TxtNombre" Grid.Column="1" Style="{StaticResource Campo.Texto}" MaxLength="40"
                                 comp:CampoAyudante.TextoEjemplo="Ej. Mario"
                                 ToolTip="Nombre de pila del empleado" TextChanged="Nombre_Cambiado"/>

                        <TextBlock Grid.Column="3" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center">
                            <Run Text="Apellidos"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                        </TextBlock>
                        <TextBox x:Name="TxtApellidos" Grid.Column="4" Style="{StaticResource Campo.Texto}" MaxLength="60"
                                 comp:CampoAyudante.TextoEjemplo="Ej. García León"
                                 ToolTip="Apellidos del empleado" TextChanged="Nombre_Cambiado"/>

                        <TextBlock Grid.Row="2" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center">
                            <Run Text="Teléfono"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                        </TextBlock>
                        <TextBox x:Name="TxtTelefonos" Grid.Row="2" Grid.Column="1" Style="{StaticResource Campo.Texto}" MaxLength="60"
                                 comp:CampoAyudante.TextoEjemplo="Ej. 600 111 222"
                                 ToolTip="Uno o varios teléfonos de contacto separados por comas"
                                 TextChanged="Campo_Cambiado"/>

                        <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center">
                            <Run Text="Email"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                        </TextBlock>
                        <TextBox x:Name="TxtCorreos" Grid.Row="2" Grid.Column="4" Style="{StaticResource Campo.Texto}" MaxLength="120"
                                 comp:CampoAyudante.TextoEjemplo="Ej. mario@mail.es"
                                 ToolTip="Uno o varios correos electrónicos separados por comas"
                                 TextChanged="Campo_Cambiado"/>
                    </Grid>
                </GroupBox>

                <!-- Competencias y formación + Fotografía -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Style="{StaticResource Grupo}" Header="Competencias y formación">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Idiomas" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtIdiomas" Grid.Column="1" Style="{StaticResource Campo.Texto}" MaxLength="80"
                                     comp:CampoAyudante.TextoEjemplo="Ej. Español, Inglés B2"
                                     ToolTip="Idiomas que habla el empleado y, si quieres, su nivel"
                                     TextChanged="Campo_Cambiado"/>
                            <TextBlock Grid.Row="2" Text="Formación" Style="{StaticResource Texto.Etiqueta}" Margin="0,10,0,0"/>
                            <TextBox x:Name="TxtFormacion" Grid.Row="2" Grid.Column="1" Style="{StaticResource Campo.TextoLargo}"
                                     Height="70" MaxLength="300"
                                     comp:CampoAyudante.TextoEjemplo="Ej. Título de monitor de ocio y tiempo libre"
                                     ToolTip="Títulos, cursos o experiencia relevante para el puesto"
                                     TextChanged="Campo_Cambiado"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Style="{StaticResource Grupo}" Header="Fotografía">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <comp:AvatarUsuario x:Name="VistaPreviaFoto" Width="96" Height="96"
                                                    ToolTip="Vista previa de la foto. Sin foto se muestran las iniciales"/>
                                <TextBlock Text="Vista previa" Style="{StaticResource Texto.Nota}" FontSize="11"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="16,4,0,0">
                                <Button x:Name="BtnSeleccionarFoto" Style="{StaticResource Boton.SecundarioPequeno}"
                                        Content="Seleccionar foto"
                                        ToolTip="Elegir una foto reciente en JPG o PNG" Click="SeleccionarFoto_Click"/>
                                <Button x:Name="BtnQuitarFoto" Style="{StaticResource Boton.SecundarioPequeno}"
                                        Content="Quitar foto" Margin="0,8,0,0" IsEnabled="False"
                                        ToolTip="Quitar la foto elegida" Click="QuitarFoto_Click"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>

                <!-- Disponibilidad y observaciones -->
                <GroupBox Style="{StaticResource Grupo}" Header="Disponibilidad y observaciones" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Disponibilidad" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbDisponibilidad" Grid.Column="1" Style="{StaticResource Campo.Desplegable}"
                                  ToolTip="Franja en la que el empleado puede trabajar"
                                  SelectionChanged="Campo_Cambiado"/>
                        <TextBlock Grid.Column="3" Text="Días no disponibles" Style="{StaticResource Texto.Etiqueta}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox x:Name="TxtDiasNoDisponibles" Grid.Column="4" Style="{StaticResource Campo.Texto}" MaxLength="80"
                                 comp:CampoAyudante.TextoEjemplo="Ej. domingos y 18-20 julio"
                                 ToolTip="Días o fechas en los que no puede trabajar (opcional)"
                                 TextChanged="Campo_Cambiado"/>
                        <TextBlock Grid.Row="2" Text="Restricciones" Style="{StaticResource Texto.Etiqueta}" Margin="0,10,0,0"/>
                        <TextBox x:Name="TxtRestricciones" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                                 Style="{StaticResource Campo.TextoLargo}" Height="70" MaxLength="300"
                                 comp:CampoAyudante.TextoEjemplo="Anota incompatibilidades horarias, vacaciones o tareas que no puede realizar."
                                 ToolTip="Observaciones sobre la disponibilidad del empleado (opcional)"
                                 TextChanged="Campo_Cambiado"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</comp:VistaBase>
