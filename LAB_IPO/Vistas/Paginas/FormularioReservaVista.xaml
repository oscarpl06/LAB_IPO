<comp:VistaBase x:Class="LAB_IPO.Vistas.Paginas.FormularioReservaVista"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:comp="clr-namespace:LAB_IPO.Componentes">

    <comp:VistaBase.Resources>
        <Style x:Key="Etiqueta.Campo" TargetType="TextBlock" BasedOn="{StaticResource Texto.Etiqueta}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="122"/>
        </Style>
        <Style x:Key="Etiqueta.Intermedia" TargetType="TextBlock" BasedOn="{StaticResource Texto.Etiqueta}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="30,0,12,0"/>
        </Style>
    </comp:VistaBase.Resources>

    <!-- PG09 · Formulario de reserva (CU-16) -->
    <DockPanel>
        <!-- Cabecera -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Nueva reserva" Style="{StaticResource Texto.TituloSeccion}"/>
            <TextBlock Text="Registra una estancia y comprueba la disponibilidad antes de guardar."
                       Style="{StaticResource Texto.Secundario}" Margin="0,6,0,0"/>
            <Border Style="{StaticResource Separador}" Margin="0,14,0,12"/>
        </StackPanel>

        <!-- Pie: errores y botones -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="PanelError" Background="{StaticResource Pincel.ErrorFondo}" CornerRadius="10"
                    Padding="12,8" Margin="0,0,20,0" VerticalAlignment="Center" Visibility="Hidden">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icono}" Text="{StaticResource Icono.Error}"
                               FontSize="14" Foreground="{StaticResource Pincel.Error}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                    <TextBlock x:Name="TxtError" Style="{StaticResource Texto.Base}" Foreground="{StaticResource Pincel.Error}"
                               TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnCancelarFormulario" Style="{StaticResource Boton.Secundario}" Content="Cancelar"
                        MinWidth="120" Margin="0,0,12,0" ToolTip="Volver sin guardar la reserva" Click="Cancelar_Click"/>
                <Button x:Name="BtnGuardar" Style="{StaticResource Boton.Primario}" MinWidth="190"
                        ToolTip="Comprobar la disponibilidad y registrar la reserva" Click="Guardar_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icono}" Text="&#xE74E;" FontSize="14" Margin="0,0,8,0"
                                   Foreground="{StaticResource Pincel.Blanco}"/>
                        <TextBlock Text="Guardar reserva"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,6,0">
            <StackPanel Margin="0,0,0,8">

                <!-- 1. Estancia y alojamiento -->
                <GroupBox Style="{StaticResource Grupo}" Header="1. Estancia y alojamiento">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Etiqueta.Campo}">
                                <Run Text="Entrada"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                            </TextBlock>
                            <comp:CampoFecha x:Name="FechaEntrada" Width="160"
                                             ToolTip="Día de llegada (dd/mm/aaaa). No puede ser anterior a hoy"/>
                            <TextBlock Style="{StaticResource Etiqueta.Intermedia}">
                                <Run Text="Salida"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                            </TextBlock>
                            <comp:CampoFecha x:Name="FechaSalida" Width="160"
                                             ToolTip="Día de salida (dd/mm/aaaa). Debe ser posterior a la entrada"/>
                            <TextBlock Style="{StaticResource Etiqueta.Intermedia}">
                                <Run Text="Tipo"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                            </TextBlock>
                            <ComboBox x:Name="CmbTipo" Style="{StaticResource Campo.Desplegable}" Width="190"
                                      comp:CampoAyudante.TextoEjemplo="Bungalow / Parcela"
                                      ToolTip="Clase de alojamiento que se reserva"
                                      SelectionChanged="CmbTipo_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource Etiqueta.Campo}">
                                <Run Text="Alojamiento"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                            </TextBlock>
                            <ComboBox x:Name="CmbAlojamiento" Style="{StaticResource Campo.Desplegable}" Width="290"
                                      comp:CampoAyudante.TextoEjemplo="Selecciona una unidad..."
                                      ToolTip="Parcela o bungalow concreto que se reserva"
                                      SelectionChanged="Campo_Cambiado"/>
                            <Button x:Name="BtnVerDisponibilidad" Style="{StaticResource Boton.Secundario}" Margin="12,0,0,0"
                                    ToolTip="Comprobar si el alojamiento está libre en esas fechas para esos ocupantes"
                                    Click="VerDisponibilidad_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icono}" Text="&#xE787;" FontSize="14" Margin="0,0,8,0"
                                               Foreground="{StaticResource Pincel.Bosque800}"/>
                                    <TextBlock Text="Ver disponibilidad"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource Etiqueta.Campo}">
                                <Run Text="Adultos"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                            </TextBlock>
                            <TextBox x:Name="TxtAdultos" Style="{StaticResource Campo.Texto}" Width="70" MaxLength="2"
                                     comp:CampoAyudante.TextoEjemplo="2" ToolTip="Número de adultos (al menos 1)"
                                     PreviewTextInput="SoloNumeros" TextChanged="Ocupantes_Cambiado"/>
                            <TextBlock Text="Niños" Style="{StaticResource Etiqueta.Intermedia}"/>
                            <TextBox x:Name="TxtNinos" Style="{StaticResource Campo.Texto}" Width="70" MaxLength="2"
                                     comp:CampoAyudante.TextoEjemplo="0" ToolTip="Número de niños (puede ser 0)"
                                     PreviewTextInput="SoloNumeros" TextChanged="Ocupantes_Cambiado"/>
                            <TextBlock Style="{StaticResource Etiqueta.Intermedia}">
                                <Run Text="Ocupantes"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                            </TextBlock>
                            <TextBox x:Name="TxtOcupantes" Style="{StaticResource Campo.Texto}" Width="70" IsEnabled="False"
                                     ToolTipService.ShowOnDisabled="True"
                                     ToolTip="Se calcula solo: adultos + niños"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="Hora de llegada" Style="{StaticResource Etiqueta.Campo}"/>
                            <ComboBox x:Name="CmbHoraLlegada" Style="{StaticResource Campo.Desplegable}" Width="190"
                                      ToolTip="Franja horaria estimada de llegada al camping"/>
                            <TextBlock Text="Hora de salida" Style="{StaticResource Etiqueta.Intermedia}"/>
                            <ComboBox x:Name="CmbHoraSalida" Style="{StaticResource Campo.Desplegable}" Width="190"
                                      ToolTip="Hora estimada de salida el último día"/>
                        </StackPanel>

                        <!-- Estado de la comprobación de disponibilidad -->
                        <Border x:Name="AvisoDisponibilidad" CornerRadius="10" BorderThickness="1" Padding="14,10"
                                Margin="0,16,0,0">
                            <DockPanel>
                                <TextBlock x:Name="IconoDisponibilidad" DockPanel.Dock="Left" Style="{StaticResource Icono}"
                                           FontSize="14" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                <StackPanel>
                                    <TextBlock x:Name="TxtDisponibilidad" Style="{StaticResource Texto.Base}" TextWrapping="Wrap"/>

                                    <!-- Alternativas del mismo tipo libres en esas fechas -->
                                    <StackPanel x:Name="PanelAlternativas" Margin="0,10,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtAlternativas" Style="{StaticResource Texto.Base}"
                                                   FontWeight="SemiBold" Foreground="{StaticResource Pincel.TextoPrincipal}"
                                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <ItemsControl x:Name="ListaAlternativas">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Boton.SecundarioPequeno}" Margin="0,0,8,8"
                                                            Padding="12,0" Click="Alternativa_Click"
                                                            ToolTip="Elegir este alojamiento y volver a comprobar la disponibilidad">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Icono}" Text="&#xE73E;" FontSize="11"
                                                                       Foreground="{StaticResource Pincel.Bosque700}" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding Texto}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- 2. Datos de la persona titular -->
                <GroupBox Style="{StaticResource Grupo}" Header="2. Datos de la persona titular" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Etiqueta.Campo}">
                                <Run Text="Nombre"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                            </TextBlock>
                            <TextBox x:Name="TxtTitular" Style="{StaticResource Campo.Texto}" Width="300" MaxLength="80"
                                     comp:CampoAyudante.TextoEjemplo="Nombre y apellidos"
                                     ToolTip="Nombre y apellidos de la persona que hace la reserva"
                                     TextChanged="Campo_Cambiado"/>
                            <TextBlock Style="{StaticResource Etiqueta.Intermedia}">
                                <Run Text="Teléfono"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                            </TextBlock>
                            <TextBox x:Name="TxtTelefonos" Style="{StaticResource Campo.Texto}" Width="260" MaxLength="80"
                                     comp:CampoAyudante.TextoEjemplo="600 123 456"
                                     ToolTip="Uno o más teléfonos de 9 cifras separados por comas"
                                     TextChanged="Campo_Cambiado"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="Email" Style="{StaticResource Etiqueta.Campo}"/>
                            <TextBox x:Name="TxtCorreo" Style="{StaticResource Campo.Texto}" Width="300" MaxLength="80"
                                     comp:CampoAyudante.TextoEjemplo="nombre@correo.es"
                                     ToolTip="Correo electrónico de contacto (opcional)"
                                     TextChanged="Campo_Cambiado"/>
                            <TextBlock Text="Documento" Style="{StaticResource Etiqueta.Intermedia}"/>
                            <TextBox x:Name="TxtDocumento" Style="{StaticResource Campo.Texto}" Width="200" MaxLength="20"
                                     CharacterCasing="Upper"
                                     comp:CampoAyudante.TextoEjemplo="Opcional"
                                     ToolTip="DNI, NIE o pasaporte de la persona titular (opcional)"
                                     TextChanged="Campo_Cambiado"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Texto.Nota}" Margin="0,12,0,0"
                                   Text="Si hay varios teléfonos, sepáralos con comas."/>
                    </StackPanel>
                </GroupBox>

                <!-- 3. Solicitudes especiales -->
                <GroupBox Style="{StaticResource Grupo}" Header="3. Solicitudes especiales" Margin="0,14,0,0">
                    <TextBox x:Name="TxtSolicitudes" Style="{StaticResource Campo.TextoLargo}" MaxLength="500"
                             comp:CampoAyudante.TextoEjemplo="Cuna, movilidad reducida, equipamiento, comentarios..."
                             ToolTip="Peticiones o comentarios de la persona titular (opcional)"/>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</comp:VistaBase>
