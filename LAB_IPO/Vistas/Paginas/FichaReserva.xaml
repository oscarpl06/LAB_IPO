<UserControl x:Class="LAB_IPO.Vistas.Paginas.FichaReserva"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="Ficha.Etiqueta" TargetType="TextBlock" BasedOn="{StaticResource Texto.Nota}">
            <Setter Property="Width" Value="130"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="Ficha.Valor" TargetType="TextBlock" BasedOn="{StaticResource Texto.Base}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Width" Value="230"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
        <Style x:Key="Ficha.Seccion" TargetType="TextBlock" BasedOn="{StaticResource Texto.Etiqueta}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Ficha.Linea" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <!-- CU-17 · Ficha de consulta de una reserva (RF-19), en el panel lateral de la ventana principal -->
    <DockPanel>
        <!-- Pie: la edición llegará con el CU-18 -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Pincel.Borde}" BorderThickness="0,1,0,0"
                Padding="26,14">
            <Button x:Name="BtnEditarReserva" Style="{StaticResource Boton.Primario}" HorizontalAlignment="Stretch"
                    IsEnabled="{Binding PuedeEditarse, Mode=OneWay}" ToolTipService.ShowOnDisabled="True"
                    ToolTip="{Binding AyudaEditar}" Click="Editar_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icono}" Text="&#xE70F;" FontSize="14" Margin="0,0,8,0"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock Text="Editar reserva"/>
                </StackPanel>
            </Button>
        </Border>

        <!-- Cabecera -->
        <Grid DockPanel.Dock="Top" Margin="26,22,16,0">
            <StackPanel>
                <TextBlock Text="FICHA DE LA RESERVA" Style="{StaticResource Texto.Rotulo}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding Localizador}" Style="{StaticResource Texto.TituloSeccion}"/>
                    <Border Style="{StaticResource Chip.Reserva}" VerticalAlignment="Center" Margin="12,4,0,0">
                        <TextBlock Style="{StaticResource Chip.ReservaTexto}"/>
                    </Border>
                </StackPanel>
            </StackPanel>
            <Button x:Name="BtnCerrarFicha" Style="{StaticResource Boton.Ventana}" Width="36" Height="36"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Focusable="True"
                    Content="{StaticResource Icono.Cerrar}" ToolTip="Cerrar la ficha (Esc)"
                    Click="Cerrar_Click"/>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,16,0,0">
            <StackPanel Margin="26,0,26,26">
                <!-- Alojamiento con su foto -->
                <Grid Height="170">
                    <Border CornerRadius="14" Background="{StaticResource Pincel.Salvia100}">
                        <TextBlock Style="{StaticResource Icono}" Text="&#xE80F;" FontSize="30"
                                   Foreground="{StaticResource Pincel.Salvia500}"/>
                    </Border>
                    <Border CornerRadius="14">
                        <Border.Background>
                            <ImageBrush x:Name="FotoAlojamiento" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <Border VerticalAlignment="Bottom" CornerRadius="0,0,14,14" Padding="14,10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00162E1F" Offset="0"/>
                                <GradientStop Color="#CC162E1F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="{Binding NombreAlojamiento}" FontFamily="{StaticResource Fuente.Titulos}"
                                       FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Blanco}"/>
                            <TextBlock Text="{Binding DetalleAlojamiento}" FontSize="12" Foreground="#E6FFFFFF"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Estancia -->
                <TextBlock Text="Estancia" Style="{StaticResource Ficha.Seccion}" Margin="0,22,0,12"/>
                <StackPanel Style="{StaticResource Ficha.Linea}">
                    <TextBlock Text="Entrada" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Style="{StaticResource Ficha.Valor}">
                        <Run Text="{Binding Entrada, StringFormat='dd/MM/yyyy', Mode=OneWay}"/>
                        <Run Text="·" Foreground="{StaticResource Pincel.TextoTenue}"/>
                        <Run Text="{Binding HoraLlegada, Mode=OneWay}" FontWeight="Normal"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Style="{StaticResource Ficha.Linea}">
                    <TextBlock Text="Salida" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Style="{StaticResource Ficha.Valor}">
                        <Run Text="{Binding Salida, StringFormat='dd/MM/yyyy', Mode=OneWay}"/>
                        <Run Text="·" Foreground="{StaticResource Pincel.TextoTenue}"/>
                        <Run Text="{Binding HoraSalida, Mode=OneWay}" FontWeight="Normal"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Style="{StaticResource Ficha.Linea}">
                    <TextBlock Text="Duración" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding NochesTexto}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource Ficha.Linea}" Margin="0">
                    <TextBlock Text="Ocupantes" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding OcupantesTexto}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>

                <Border Style="{StaticResource Separador}" Margin="0,20,0,18"/>

                <!-- Titular -->
                <TextBlock Text="Persona titular" Style="{StaticResource Ficha.Seccion}"/>
                <StackPanel Style="{StaticResource Ficha.Linea}">
                    <TextBlock Text="Nombre" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding Titular}" Style="{StaticResource Ficha.Valor}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Style="{StaticResource Ficha.Linea}">
                    <TextBlock Text="Teléfonos" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding TelefonosLista}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource Ficha.Linea}">
                    <TextBlock Text="E-mail" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding CorreoTexto}" Style="{StaticResource Ficha.Valor}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Style="{StaticResource Ficha.Linea}" Margin="0">
                    <TextBlock Text="Documento" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding DocumentoTexto}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>

                <Border Style="{StaticResource Separador}" Margin="0,20,0,18"/>

                <!-- Solicitudes especiales -->
                <TextBlock Text="Solicitudes especiales" Style="{StaticResource Ficha.Seccion}" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding SolicitudesTexto}" Style="{StaticResource Texto.Secundario}" FontSize="14"
                           TextWrapping="Wrap" LineHeight="21"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
