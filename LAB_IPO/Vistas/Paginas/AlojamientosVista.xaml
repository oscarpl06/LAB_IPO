<comp:VistaBase x:Class="LAB_IPO.Vistas.Paginas.AlojamientosVista"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:comp="clr-namespace:LAB_IPO.Componentes">

    <comp:VistaBase.Resources>
        <!-- Anchos de columna compartidos por la cabecera y las filas -->
        <GridLength x:Key="Col.Foto">76</GridLength>
        <GridLength x:Key="Col.Id">64</GridLength>
        <GridLength x:Key="Col.Tipo">104</GridLength>
        <GridLength x:Key="Col.Tamano">74</GridLength>
        <GridLength x:Key="Col.Ubicacion">176</GridLength>
        <GridLength x:Key="Col.Estado">126</GridLength>
        <GridLength x:Key="Col.Acciones">214</GridLength>

        <!-- Fila de la tabla: resalta al pasar el ratón y al estar seleccionada -->
        <Style x:Key="Fila.Parcela" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Fila" BorderBrush="{StaticResource Pincel.Borde}" BorderThickness="0,0,0,1"
                                Background="Transparent">
                            <Grid>
                                <Border x:Name="Acento" Width="3" HorizontalAlignment="Left" Margin="0,8"
                                        CornerRadius="2" Background="{StaticResource Pincel.Bosque700}" Visibility="Collapsed"/>
                                <ContentPresenter Margin="14,8"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fila" Property="Background" Value="{StaticResource Pincel.BlancoCalido}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fila" Property="Background" Value="{StaticResource Pincel.Salvia100}"/>
                                <Setter TargetName="Acento" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </comp:VistaBase.Resources>

    <!-- PG3 · Alojamientos (listado de parcelas) -->
    <DockPanel>
        <!-- Cabecera de la sección -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Alojamientos" Style="{StaticResource Texto.TituloSeccion}"/>
            <TextBlock Text="Consulta y gestiona las parcelas y los bungalows del complejo"
                       Style="{StaticResource Texto.Secundario}" Margin="0,6,0,0"/>
            <Border Style="{StaticResource Separador}" Margin="0,14,0,12"/>

            <!-- Pestañas Parcelas / Bungalows -->
            <Border Background="{StaticResource Pincel.Arena200}" CornerRadius="10" Padding="4"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabParcelas" Style="{StaticResource Boton.Pestana}" GroupName="TipoAlojamiento"
                                 Content="Parcelas" IsChecked="True" ToolTip="Listado de parcelas"
                                 Checked="Pestana_Checked"/>
                    <RadioButton x:Name="TabBungalows" Style="{StaticResource Boton.Pestana}" GroupName="TipoAlojamiento"
                                 Content="Bungalows" ToolTip="Bungalows y cabañas de madera"
                                 Checked="Pestana_Checked"/>
                </StackPanel>
            </Border>

            <!-- Filtros de búsqueda -->
            <GroupBox x:Name="GrupoFiltros" Style="{StaticResource Grupo}" Header="Filtros de búsqueda" Margin="0,12,0,0"
                      Padding="20,10,20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Buscar" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtBuscar" Grid.Column="1" Style="{StaticResource Campo.Texto}" Height="34"
                             comp:CampoAyudante.TextoEjemplo="Identificador o ubicación"
                             ToolTip="Escribe parte del identificador (P-03) o de la ubicación (piscina) y pulsa Intro"
                             KeyDown="Buscar_KeyDown"/>
                    <TextBlock Grid.Column="2" Text="Tipo" Style="{StaticResource Texto.Etiqueta}"
                               VerticalAlignment="Center" Margin="18,0,10,0"/>
                    <ComboBox x:Name="CmbFiltroTipo" Grid.Column="3" Style="{StaticResource Campo.Desplegable}"
                              Height="34" DisplayMemberPath="Texto"
                              ToolTip="Mostrar solo las parcelas de un tipo"/>
                    <TextBlock Grid.Column="4" Text="Estado" Style="{StaticResource Texto.Etiqueta}"
                               VerticalAlignment="Center" Margin="18,0,10,0"/>
                    <ComboBox x:Name="CmbFiltroEstado" Grid.Column="5" Style="{StaticResource Campo.Desplegable}"
                              Height="34" DisplayMemberPath="Texto"
                              ToolTip="Mostrar solo las parcelas con un estado de disponibilidad"/>
                    <Button x:Name="BtnFiltrar" Grid.Column="6" Style="{StaticResource Boton.SecundarioPequeno}"
                            Content="Filtrar" Height="34" Margin="18,0,8,0"
                            ToolTip="Aplicar los filtros al listado" Click="Filtrar_Click"/>
                    <Button x:Name="BtnLimpiar" Grid.Column="7" Style="{StaticResource Boton.SecundarioPequeno}"
                            Content="Limpiar" Height="34"
                            ToolTip="Quitar los filtros y mostrar todas las parcelas" Click="Limpiar_Click"/>
                </Grid>
            </GroupBox>

            <!-- Filtros de bungalows (CU-10) -->
            <GroupBox x:Name="GrupoFiltrosBungalows" Style="{StaticResource Grupo}" Header="Filtros de búsqueda"
                      Margin="0,12,0,0" Padding="20,10,20,14" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Buscar" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtBuscarBungalow" Grid.Column="1" Style="{StaticResource Campo.Texto}" Height="34"
                             comp:CampoAyudante.TextoEjemplo="Nombre o descripción"
                             ToolTip="Escribe parte del nombre (04) o de la descripción (chimenea) y pulsa Intro"
                             KeyDown="BuscarBungalow_KeyDown"/>
                    <TextBlock Grid.Column="2" Text="Capacidad" Style="{StaticResource Texto.Etiqueta}"
                               VerticalAlignment="Center" Margin="18,0,10,0"/>
                    <ComboBox x:Name="CmbFiltroCapacidad" Grid.Column="3" Style="{StaticResource Campo.Desplegable}"
                              Height="34" DisplayMemberPath="Texto"
                              ToolTip="Mostrar solo los bungalows con sitio para al menos ese número de personas"/>
                    <TextBlock Grid.Column="4" Text="Estado" Style="{StaticResource Texto.Etiqueta}"
                               VerticalAlignment="Center" Margin="18,0,10,0"/>
                    <ComboBox x:Name="CmbFiltroEstadoBungalow" Grid.Column="5" Style="{StaticResource Campo.Desplegable}"
                              Height="34" DisplayMemberPath="Texto"
                              ToolTip="Mostrar solo los bungalows con un estado de disponibilidad"/>
                    <Button x:Name="BtnFiltrarBungalows" Grid.Column="6" Style="{StaticResource Boton.SecundarioPequeno}"
                            Content="Filtrar" Height="34" Margin="18,0,8,0"
                            ToolTip="Aplicar los filtros a los bungalows" Click="FiltrarBungalows_Click"/>
                    <Button x:Name="BtnLimpiarBungalows" Grid.Column="7" Style="{StaticResource Boton.SecundarioPequeno}"
                            Content="Limpiar" Height="34"
                            ToolTip="Quitar los filtros y mostrar todos los bungalows" Click="LimpiarBungalows_Click"/>
                </Grid>
            </GroupBox>

            <!-- Recuento y acciones -->
            <Grid Margin="0,16,0,10">
                <TextBlock x:Name="TxtRecuento" Style="{StaticResource Texto.Secundario}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnTiposTarifas" Style="{StaticResource Boton.Secundario}" Content="Tipos y tarifas" MinWidth="180"
                            IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Sección en desarrollo"
                            Margin="0,0,12,0"/>
                    <Button x:Name="BtnNuevaParcela" Style="{StaticResource Boton.Primario}" MinWidth="200"
                            ToolTip="Registrar una parcela nueva en el camping" Click="NuevaParcela_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icono}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0"
                                       Foreground="{StaticResource Pincel.Blanco}"/>
                            <TextBlock x:Name="TxtNuevo" Text="Nueva parcela"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Aviso de alta correcta -->
            <Border x:Name="AvisoGuardado" Background="{StaticResource Pincel.Salvia100}" CornerRadius="10"
                    BorderBrush="{StaticResource Pincel.Salvia200}" BorderThickness="1"
                    Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Pincel.Bosque700}">
                        <TextBlock Style="{StaticResource Icono}" Text="{StaticResource Icono.Correcto}" FontSize="11"
                                   Foreground="{StaticResource Pincel.Blanco}"/>
                    </Border>
                    <TextBlock x:Name="TxtAvisoGuardado" Style="{StaticResource Texto.Base}" FontWeight="SemiBold"
                               Foreground="{StaticResource Pincel.Bosque800}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Pie: paginación y aviso -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid>
                <TextBlock x:Name="TxtPaginacion" Style="{StaticResource Texto.Nota}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Boton.Fila}" Content="Anterior" MinWidth="90" Margin="0,0,8,0"
                            IsEnabled="False"/>
                    <Button Style="{StaticResource Boton.Fila}" Content="Siguiente" MinWidth="90" IsEnabled="False"/>
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Style="{StaticResource Icono}" Text="{StaticResource Icono.Aviso}" FontSize="14"
                           Foreground="{StaticResource Pincel.Aviso}"/>
                <TextBlock x:Name="TxtAvisoEliminar" Style="{StaticResource Texto.Nota}" Margin="8,0,0,0"
                           Text="Al eliminar una parcela se solicitará confirmación antes de borrar sus datos."/>
            </StackPanel>
        </StackPanel>

        <Grid>
        <!-- ===== Bungalows: tarjetas con foto (CU-07) ===== -->
        <ScrollViewer x:Name="PanelBungalows" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="Collapsed" Padding="0,0,4,0">
            <ItemsControl x:Name="ListaBungalows" Margin="-8,-4,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300" Margin="8,4,8,14" Style="{StaticResource Tarjeta}" CornerRadius="16">
                            <StackPanel>
                                <!-- Foto de portada -->
                                <Grid Height="170">
                                    <Border CornerRadius="16,16,0,0" Background="{StaticResource Pincel.Salvia100}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Icono}" Text="&#xE91B;" FontSize="26"
                                                       Foreground="{StaticResource Pincel.Salvia500}"/>
                                            <TextBlock Text="Sin fotos" Style="{StaticResource Texto.Nota}"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="16,16,0,0">
                                        <Border.Background>
                                            <ImageBrush Stretch="UniformToFill"
                                                        ImageSource="{Binding Portada, Converter={StaticResource RutaImagen}, ConverterParameter=600}"/>
                                        </Border.Background>
                                    </Border>
                                    <Border Style="{StaticResource Chip.Estado}" VerticalAlignment="Top" Margin="12">
                                        <TextBlock Text="{Binding EstadoTexto}" Style="{StaticResource Chip.EstadoTexto}"/>
                                    </Border>
                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="12"
                                            Background="#B3172A1F" CornerRadius="10" Padding="8,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icono}" Text="&#xE91B;" FontSize="11"
                                                       Foreground="{StaticResource Pincel.Blanco}"/>
                                            <TextBlock Text="{Binding FotosTexto}" FontSize="11" Margin="5,0,0,0"
                                                       Foreground="{StaticResource Pincel.Blanco}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Datos -->
                                <StackPanel Margin="18,14,18,16">
                                    <TextBlock Text="{Binding Nombre}" Style="{StaticResource Texto.TituloDialogo}" FontSize="17"/>
                                    <TextBlock Style="{StaticResource Texto.Secundario}" Margin="0,4,0,0">
                                        <Run Text="{Binding TamanoTexto, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding CapacidadTexto, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding EquipamientoTexto}" Style="{StaticResource Texto.Nota}"
                                               Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>

                                    <Border Style="{StaticResource Separador}" Margin="0,12,0,10"/>

                                    <Grid>
                                        <StackPanel>
                                            <TextBlock>
                                                <Run Text="{Binding PrecioTexto, Mode=OneWay}" FontFamily="{StaticResource Fuente.Titulos}"
                                                     FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Bosque800}"/>
                                                <Run Text=" / noche" FontSize="12" Foreground="{StaticResource Pincel.TextoSecundario}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding EstanciaTexto}" Style="{StaticResource Texto.Nota}" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Boton.Fila}" Content="Ver" Margin="0,0,6,0"
                                                    ToolTip="Ver la ficha completa del bungalow" Click="VerBungalow_Click"/>
                                            <Button Style="{StaticResource Boton.Fila}" Content="Editar"
                                                    IsEnabled="False" ToolTip="Sección en desarrollo"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bungalows: sin resultados con los filtros -->
        <StackPanel x:Name="PanelSinBungalows" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="Collapsed">
            <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource Pincel.Salvia100}">
                <TextBlock Style="{StaticResource Icono}" Text="&#xE721;" FontSize="22"
                           Foreground="{StaticResource Pincel.Bosque700}"/>
            </Border>
            <TextBlock Style="{StaticResource Texto.Etiqueta}" FontSize="15" HorizontalAlignment="Center"
                       Margin="0,14,0,4" Text="No hay bungalows que coincidan con los filtros"/>
            <TextBlock Style="{StaticResource Texto.Nota}" HorizontalAlignment="Center"
                       Text="Prueba con otra búsqueda o quita los filtros."/>
            <Button Style="{StaticResource Boton.Enlace}" Content="Quitar filtros" HorizontalAlignment="Center"
                    Margin="0,10,0,0" Click="LimpiarBungalows_Click"/>
        </StackPanel>

        <!-- Tabla de parcelas + ficha lateral -->
        <Grid x:Name="PanelParcelas">
            <Border Style="{StaticResource Tarjeta}" CornerRadius="14">
                <DockPanel>
                    <!-- Cabecera de la tabla -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource Pincel.Beige100}" CornerRadius="14,14,0,0"
                            BorderBrush="{StaticResource Pincel.Borde}" BorderThickness="0,0,0,1" Padding="14,0" Height="40">
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Nota}">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{StaticResource Pincel.TextoSecundario}"/>
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource Col.Foto}"/>
                                <ColumnDefinition Width="{StaticResource Col.Id}"/>
                                <ColumnDefinition Width="{StaticResource Col.Tipo}"/>
                                <ColumnDefinition Width="{StaticResource Col.Tamano}"/>
                                <ColumnDefinition Width="{StaticResource Col.Ubicacion}"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="{StaticResource Col.Estado}"/>
                                <ColumnDefinition Width="{StaticResource Col.Acciones}"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Foto"/>
                            <TextBlock Grid.Column="1" Text="ID"/>
                            <TextBlock Grid.Column="2" Text="Tipo"/>
                            <TextBlock Grid.Column="3" Text="Tamaño"/>
                            <TextBlock Grid.Column="4" Text="Ubicación"/>
                            <TextBlock Grid.Column="5" Text="Servicios"/>
                            <TextBlock Grid.Column="6" Text="Estado"/>
                            <TextBlock Grid.Column="7" Text="Acciones"/>
                        </Grid>
                    </Border>

                    <Grid>
                        <!-- Filas -->
                        <ListBox x:Name="ListaParcelas" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource Fila.Parcela}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 IsSynchronizedWithCurrentItem="False"
                                 SelectionChanged="ListaParcelas_SelectionChanged">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer Focusable="False">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource Col.Foto}"/>
                                            <ColumnDefinition Width="{StaticResource Col.Id}"/>
                                            <ColumnDefinition Width="{StaticResource Col.Tipo}"/>
                                            <ColumnDefinition Width="{StaticResource Col.Tamano}"/>
                                            <ColumnDefinition Width="{StaticResource Col.Ubicacion}"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="{StaticResource Col.Estado}"/>
                                            <ColumnDefinition Width="{StaticResource Col.Acciones}"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Miniatura -->
                                        <Grid Grid.Column="0" Width="60" Height="42" HorizontalAlignment="Left">
                                            <Border CornerRadius="8" Background="{StaticResource Pincel.Salvia100}">
                                                <TextBlock Style="{StaticResource Icono}" Text="&#xE91B;" FontSize="16"
                                                           Foreground="{StaticResource Pincel.Salvia500}"/>
                                            </Border>
                                            <Border CornerRadius="8">
                                                <Border.Background>
                                                    <ImageBrush Stretch="UniformToFill"
                                                                ImageSource="{Binding RutaFoto, Converter={StaticResource RutaImagen}, ConverterParameter=160}"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Column="1" Text="{Binding Identificador}" Style="{StaticResource Texto.Base}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Tipo.Nombre}" Style="{StaticResource Texto.Base}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TamanoTexto}" Style="{StaticResource Texto.Base}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Ubicacion}" Style="{StaticResource Texto.Base}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="5" Text="{Binding ServiciosTexto}" Style="{StaticResource Texto.Secundario}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Border Grid.Column="6" Style="{StaticResource Chip.Estado}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding EstadoTexto}" Style="{StaticResource Chip.EstadoTexto}"/>
                                        </Border>
                                        <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Boton.Fila}" Content="Ver" Margin="0,0,6,0"
                                                    ToolTip="Ver la ficha completa de la parcela" Click="Ver_Click"/>
                                            <Button Style="{StaticResource Boton.Fila}" Content="Editar" Margin="0,0,6,0"
                                                    IsEnabled="False" ToolTip="Sección en desarrollo"/>
                                            <Button Style="{StaticResource Boton.Fila}" Content="Eliminar"
                                                    IsEnabled="False" ToolTip="Sección en desarrollo"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Sin resultados -->
                        <StackPanel x:Name="PanelSinResultados" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource Pincel.Salvia100}">
                                <TextBlock Style="{StaticResource Icono}" Text="&#xE721;" FontSize="22"
                                           Foreground="{StaticResource Pincel.Bosque700}"/>
                            </Border>
                            <TextBlock x:Name="TxtSinResultados" Style="{StaticResource Texto.Etiqueta}" FontSize="15"
                                       HorizontalAlignment="Center" Margin="0,14,0,4"
                                       Text="No hay parcelas que coincidan con los filtros"/>
                            <TextBlock Style="{StaticResource Texto.Nota}" HorizontalAlignment="Center"
                                       Text="Prueba con otra búsqueda o quita los filtros."/>
                            <Button Style="{StaticResource Boton.Enlace}" Content="Quitar filtros" HorizontalAlignment="Center"
                                    Margin="0,10,0,0" Click="Limpiar_Click"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
        </Grid>
    </DockPanel>
</comp:VistaBase>
