<UserControl x:Class="LAB_IPO.Vistas.Paginas.FichaActividad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:LAB_IPO.Componentes">

    <UserControl.Resources>
        <Style x:Key="Ficha.Etiqueta" TargetType="TextBlock" BasedOn="{StaticResource Texto.Nota}">
            <Setter Property="Width" Value="130"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="Ficha.Valor" TargetType="TextBlock" BasedOn="{StaticResource Texto.Base}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Width" Value="230"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
        <Style x:Key="Ficha.Seccion" TargetType="TextBlock" BasedOn="{StaticResource Texto.Etiqueta}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Ficha.Linea" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Dato destacado de la cabecera (horario, cupo, precio) -->
        <Style x:Key="Ficha.Dato" TargetType="Border">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <!-- CU-27 · Ficha de consulta de una actividad (RF-29), en el panel lateral de la ventana principal -->
    <DockPanel>
        <!-- Pie: en consulta, la edición (CU-26); en gestión de monitores, Cancelar y Guardar -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Pincel.Borde}" BorderThickness="0,1,0,0"
                Padding="26,14">
            <Grid>
                <Button x:Name="BtnEditarActividad" Style="{StaticResource Boton.Primario}" HorizontalAlignment="Stretch"
                        ToolTip="Modificar los datos de esta actividad" Click="Editar_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icono}" Text="&#xE70F;" FontSize="14" Margin="0,0,8,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Text="Editar actividad"/>
                    </StackPanel>
                </Button>
                <Grid x:Name="PieGestion" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnCancelarMonitores" Style="{StaticResource Boton.Secundario}" Content="Cancelar"
                            ToolTip="Volver a la ficha sin cambiar los monitores" Click="CancelarMonitores_Click"/>
                    <Button x:Name="BtnGuardarMonitores" Grid.Column="2" Style="{StaticResource Boton.Primario}"
                            ToolTip="Guardar los monitores marcados" Click="GuardarMonitores_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icono}" Text="&#xE74E;" FontSize="14" Margin="0,0,8,0"
                                       Foreground="{StaticResource Pincel.Blanco}"/>
                            <TextBlock Text="Guardar"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Grid DockPanel.Dock="Top" Margin="26,22,16,0">
            <TextBlock x:Name="TxtRotulo" Text="FICHA DE LA ACTIVIDAD" Style="{StaticResource Texto.Rotulo}"/>
            <Button x:Name="BtnCerrarFicha" Style="{StaticResource Boton.Ventana}" Width="36" Height="36"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Focusable="True"
                    Content="{StaticResource Icono.Cerrar}" ToolTip="Cerrar la ficha (Esc)"
                    Click="Cerrar_Click"/>
        </Grid>

        <Grid>
        <ScrollViewer x:Name="VistaConsulta" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,4,0,0">
            <StackPanel Margin="26,0,26,26">
                <!-- Cabecera: nombre, destinatarios, área y datos principales -->
                <Border CornerRadius="16" Padding="20,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource Color.Bosque700}" Offset="0"/>
                            <GradientStop Color="{StaticResource Color.Bosque900}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="11" Padding="10,3" Background="{StaticResource Pincel.Blanco}">
                                <TextBlock Text="{Binding Publico}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Pincel.Bosque800}"/>
                            </Border>
                            <Border CornerRadius="11" Padding="10,3" Margin="8,0,0,0" Background="#26FFFFFF">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icono}" Text="&#xE707;" FontSize="11"
                                               Foreground="{StaticResource Pincel.Blanco}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Area}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource Pincel.Blanco}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Nombre}" FontFamily="{StaticResource Fuente.Titulos}" FontSize="24"
                                   FontWeight="SemiBold" Foreground="{StaticResource Pincel.Blanco}" TextWrapping="Wrap"
                                   Margin="0,12,0,14"/>
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource Ficha.Dato}">
                                <StackPanel>
                                    <TextBlock Text="HORARIO" FontSize="10" FontWeight="SemiBold" Foreground="#CCFFFFFF"/>
                                    <TextBlock Text="{Binding HorarioTexto}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource Pincel.Blanco}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Ficha.Dato}">
                                <StackPanel>
                                    <TextBlock Text="CUPO" FontSize="10" FontWeight="SemiBold" Foreground="#CCFFFFFF"/>
                                    <TextBlock Text="{Binding CupoTexto}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource Pincel.Blanco}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Ficha.Dato}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="PRECIO" FontSize="10" FontWeight="SemiBold" Foreground="#CCFFFFFF"/>
                                    <TextBlock Text="{Binding PrecioTexto}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource Pincel.Blanco}" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Horario y cupo -->
                <TextBlock Text="Horario y cupo" Style="{StaticResource Ficha.Seccion}" Margin="0,22,0,12"/>
                <StackPanel Style="{StaticResource Ficha.Linea}">
                    <TextBlock Text="Días" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding DiasCompletosTexto}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource Ficha.Linea}">
                    <TextBlock Text="Horario" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Style="{StaticResource Ficha.Valor}">
                        <Run Text="{Binding HorarioTexto, Mode=OneWay}"/>
                        <Run Text="·" Foreground="{StaticResource Pincel.TextoTenue}"/>
                        <Run Text="{Binding DuracionTexto, Mode=OneWay}" FontWeight="Normal"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Style="{StaticResource Ficha.Linea}">
                    <TextBlock Text="Cupo mínimo" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding CupoMinimoTexto}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource Ficha.Linea}">
                    <TextBlock Text="Cupo máximo" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding CupoMaximoTexto}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource Ficha.Linea}">
                    <TextBlock Text="Destinatarios" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding Publico}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource Ficha.Linea}" Margin="0">
                    <TextBlock Text="Precio" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding PrecioTexto}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>

                <Border Style="{StaticResource Separador}" Margin="0,20,0,18"/>

                <!-- Lugar, descripción y material -->
                <TextBlock Text="Lugar y material" Style="{StaticResource Ficha.Seccion}"/>
                <StackPanel Style="{StaticResource Ficha.Linea}">
                    <TextBlock Text="Área" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding Area}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource Ficha.Linea}">
                    <TextBlock Text="Materiales" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding MaterialesTexto}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource Ficha.Linea}" Margin="0">
                    <TextBlock Text="Notas" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding NotasTexto}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>

                <TextBlock Text="Descripción" Style="{StaticResource Ficha.Seccion}" Margin="0,20,0,8"/>
                <TextBlock Text="{Binding DescripcionTexto}" Style="{StaticResource Texto.Secundario}" FontSize="14"
                           TextWrapping="Wrap" LineHeight="21"/>

                <Border Style="{StaticResource Separador}" Margin="0,20,0,18"/>

                <!-- Monitores responsables (CU-28) -->
                <Grid x:Name="SeccionMonitores" Margin="0,0,0,12">
                    <TextBlock Text="Monitores responsables" Style="{StaticResource Ficha.Seccion}" Margin="0"
                               VerticalAlignment="Center"/>
                    <Button x:Name="BtnGestionarMonitores" Style="{StaticResource Boton.SecundarioPequeno}"
                            HorizontalAlignment="Right" Padding="12,0"
                            ToolTip="Asignar o quitar monitores de esta actividad" Click="GestionarMonitores_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icono}" Text="&#xE716;" FontSize="12" Margin="0,0,6,0"
                                       Foreground="{StaticResource Pincel.Bosque800}"/>
                            <TextBlock Text="Gestionar monitores"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <Border x:Name="AvisoMonitoresGuardados" Background="{StaticResource Pincel.Salvia100}" CornerRadius="10"
                        BorderBrush="{StaticResource Pincel.Salvia200}" BorderThickness="1" Padding="12,8"
                        Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icono}" Text="{StaticResource Icono.Correcto}" FontSize="12"
                                   Foreground="{StaticResource Pincel.Bosque700}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtMonitoresGuardados" Style="{StaticResource Texto.Base}" FontWeight="SemiBold"
                                   Foreground="{StaticResource Pincel.Bosque800}" TextWrapping="Wrap" Width="320"/>
                    </StackPanel>
                </Border>
                <ItemsControl x:Name="ListaMonitores" ItemsSource="{Binding Monitores}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <comp:AvatarUsuario Width="40" Height="40" Nombre="{Binding NombreCompleto}"
                                                    Foto="{Binding RutaFoto, Converter={StaticResource RutaImagen}, ConverterParameter=100}"/>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Width="300">
                                    <TextBlock Text="{Binding NombreCompleto}" Style="{StaticResource Texto.Base}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Formacion}" Style="{StaticResource Texto.Nota}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="AvisoSinMonitores" Background="{StaticResource Pincel.Beige100}" CornerRadius="10"
                        Padding="12,10" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icono}" Text="{StaticResource Icono.Info}" FontSize="13"
                                   Foreground="{StaticResource Pincel.Info}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Esta actividad todavía no tiene monitores asignados."
                                   Style="{StaticResource Texto.Secundario}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- CU-28 · Gestión de monitores: casillas con los empleados en activo -->
        <DockPanel x:Name="VistaGestion" Margin="26,4,26,0" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{Binding Nombre}" Style="{StaticResource Texto.TituloSeccion}" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource Texto.Secundario}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Marca los empleados que serán responsables de la actividad y desmarca los que quieras quitar."/>
                <Grid Margin="0,14,0,8">
                    <TextBlock x:Name="TxtSeleccionados" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource Boton.Enlace}" Content="Quitar todos" HorizontalAlignment="Right"
                            ToolTip="Desmarcar todos los empleados" Click="QuitarTodos_Click"/>
                </Grid>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl x:Name="ListaCandidatos" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Tarjeta" BorderBrush="{StaticResource Pincel.Borde}" BorderThickness="1"
                                    CornerRadius="12" Margin="0,0,0,8" Background="{StaticResource Pincel.Blanco}">
                                <CheckBox Style="{StaticResource Campo.Casilla}" IsChecked="{Binding Seleccionado}"
                                          Checked="Candidato_Cambiado" Unchecked="Candidato_Cambiado"
                                          HorizontalAlignment="Stretch" Padding="0" Margin="4"
                                          AutomationProperties.Name="{Binding Empleado.NombreCompleto}"
                                          ToolTip="{Binding Ayuda}">
                                    <StackPanel Orientation="Horizontal">
                                        <comp:AvatarUsuario Width="38" Height="38" Nombre="{Binding Empleado.NombreCompleto}"
                                                            Foto="{Binding Empleado.RutaFoto, Converter={StaticResource RutaImagen}, ConverterParameter=100}"/>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Width="250">
                                            <TextBlock Text="{Binding Empleado.NombreCompleto}" Style="{StaticResource Texto.Base}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detalle}" Style="{StaticResource Texto.Nota}"
                                                       FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Seleccionado}" Value="True">
                                    <Setter TargetName="Tarjeta" Property="BorderBrush" Value="{StaticResource Pincel.Bosque600}"/>
                                    <Setter TargetName="Tarjeta" Property="Background" Value="{StaticResource Pincel.Salvia100}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
