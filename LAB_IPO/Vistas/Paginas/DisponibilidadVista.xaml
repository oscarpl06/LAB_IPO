<comp:VistaBase x:Class="LAB_IPO.Vistas.Paginas.DisponibilidadVista"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:comp="clr-namespace:LAB_IPO.Componentes">

    <comp:VistaBase.Resources>
        <!-- Muestra de color de la leyenda -->
        <Style x:Key="Leyenda.Muestra" TargetType="Border">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Casilla de un día: transparente, con contorno al pasar el ratón o al estar seleccionada -->
        <Style x:Key="Casilla" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Marco" Background="Transparent" CornerRadius="6" Margin="1,3"
                                BorderThickness="2" BorderBrush="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource Pincel.Salvia500}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource Pincel.Salvia500}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource Pincel.Bosque800}"/>
                                <Setter TargetName="Marco" Property="Background" Value="#1A1F3D2B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </comp:VistaBase.Resources>

    <!-- PG8 · Disponibilidad (calendario) -->
    <DockPanel>
        <!-- Cabecera de la sección -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Disponibilidad" Style="{StaticResource Texto.TituloSeccion}"/>
            <TextBlock Text="Consulta el estado de cada alojamiento por día y crea reservas sobre los libres"
                       Style="{StaticResource Texto.Secundario}" Margin="0,6,0,0"/>
            <Border Style="{StaticResource Separador}" Margin="0,14,0,14"/>
        </StackPanel>

        <!-- Avisos inferiores del boceto -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icono}" Text="{StaticResource Icono.Info}" FontSize="13"
                           Foreground="{StaticResource Pincel.Info}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Al cambiar el estado de un alojamiento ocupado se solicitará confirmación."
                           Style="{StaticResource Texto.Nota}" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="248"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Columna izquierda: filtros, leyenda y cuadrícula ===== -->
            <DockPanel Grid.Column="0">
                <!-- Tipo y navegación por fechas -->
                <Grid DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tipo" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <ComboBox x:Name="CmbTipo" Style="{StaticResource Campo.Desplegable}" Width="210" Height="36"
                                  ToolTip="Mostrar todos los alojamientos, solo las parcelas o solo los bungalows"
                                  SelectionChanged="CmbTipo_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnAnterior" Style="{StaticResource Boton.SecundarioPequeno}" Width="36" Height="36"
                                Padding="0" ToolTip="Ver la semana anterior" Click="Anterior_Click">
                            <TextBlock Style="{StaticResource Icono}" Text="&#xE76B;" FontSize="12"
                                       Foreground="{StaticResource Pincel.Bosque800}"/>
                        </Button>
                        <TextBlock x:Name="TxtPeriodo" Style="{StaticResource Texto.Base}" FontWeight="SemiBold"
                                   FontSize="15" FontFamily="{StaticResource Fuente.Titulos}" MinWidth="230"
                                   TextAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        <Button x:Name="BtnSiguiente" Style="{StaticResource Boton.SecundarioPequeno}" Width="36" Height="36"
                                Padding="0" ToolTip="Ver la semana siguiente" Click="Siguiente_Click">
                            <TextBlock Style="{StaticResource Icono}" Text="&#xE76C;" FontSize="12"
                                       Foreground="{StaticResource Pincel.Bosque800}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Consulta por intervalo de fechas (CU-14, paso 3) -->
                <Border DockPanel.Dock="Top" Background="{StaticResource Pincel.Beige100}" CornerRadius="12"
                        BorderBrush="{StaticResource Pincel.Borde}" BorderThickness="1" Padding="14,10" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Desde" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <comp:CampoFecha x:Name="FechaDesde" Width="150" Height="36"
                                             ToolTip="Primera noche del intervalo (dd/mm/aaaa)"/>
                            <TextBlock Text="Hasta" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center"
                                       Margin="16,0,10,0"/>
                            <comp:CampoFecha x:Name="FechaHasta" Width="150" Height="36"
                                             ToolTip="Última noche del intervalo (dd/mm/aaaa)"/>
                            <Button x:Name="BtnConsultar" Style="{StaticResource Boton.Primario}" Height="36"
                                    Padding="16,0" Margin="16,0,8,0"
                                    ToolTip="Comprobar qué alojamientos tienen reservas en esas fechas" Click="Consultar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icono}" Text="&#xE721;" FontSize="13" Margin="0,0,8,0"
                                               Foreground="{StaticResource Pincel.Blanco}"/>
                                    <TextBlock Text="Consultar"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnLimpiarIntervalo" Style="{StaticResource Boton.SecundarioPequeno}"
                                    Content="Limpiar" Height="36"
                                    ToolTip="Quitar el intervalo consultado" Click="LimpiarIntervalo_Click"/>
                        </StackPanel>

                        <!-- Resultado o error de la consulta -->
                        <StackPanel x:Name="PanelResultado" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="IconoResultado" Style="{StaticResource Icono}" FontSize="14"
                                       VerticalAlignment="Top" Margin="0,2,8,0"/>
                            <TextBlock x:Name="TxtResultado" Style="{StaticResource Texto.Base}" TextWrapping="Wrap"
                                       MaxWidth="620"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Leyenda -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,14,0,10">
                    <Border Style="{StaticResource Leyenda.Muestra}" Background="{StaticResource Pincel.Salvia100}"
                            BorderBrush="{StaticResource Pincel.Salvia500}"/>
                    <TextBlock Text="Libre" Style="{StaticResource Texto.Nota}" Margin="0,0,22,0"/>
                    <Border Style="{StaticResource Leyenda.Muestra}" Background="{StaticResource Pincel.ErrorFondo}"
                            BorderBrush="{StaticResource Pincel.Error}"/>
                    <TextBlock Text="Ocupado" Style="{StaticResource Texto.Nota}" Margin="0,0,22,0"/>
                    <Border Style="{StaticResource Leyenda.Muestra}" Background="{StaticResource Pincel.AvisoFondo}"
                            BorderBrush="{StaticResource Pincel.Aviso}"/>
                    <TextBlock Text="En reparación" Style="{StaticResource Texto.Nota}" Margin="0,0,22,0"/>
                    <Border Style="{StaticResource Leyenda.Muestra}" Background="#F6EFC9" BorderBrush="#C9A93A"/>
                    <TextBlock Text="Pendiente de limpieza" Style="{StaticResource Texto.Nota}"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="Haz clic en una casilla para seleccionar el alojamiento y la fecha."
                           Style="{StaticResource Texto.Nota}" Margin="2,10,0,0"/>

                <!-- Cuadrícula alojamiento × día -->
                <Border Style="{StaticResource Tarjeta}" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Pincel.Borde}" BorderThickness="0,0,0,1"
                                Background="{StaticResource Pincel.BlancoCalido}" CornerRadius="14,14,0,0">
                            <Grid x:Name="Cabecera" Height="46" Margin="0,0,10,0"/>
                        </Border>
                        <Grid>
                            <ScrollViewer x:Name="PanelFilas" VerticalScrollBarVisibility="Auto" Focusable="False"
                                          ScrollChanged="PanelFilas_ScrollChanged">
                                <StackPanel x:Name="Filas" Margin="0,2,10,6"/>
                            </ScrollViewer>
                            <TextBlock x:Name="TxtSinAlojamientos" Text="No hay alojamientos de este tipo."
                                       Style="{StaticResource Texto.Secundario}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- ===== Columna derecha: alojamiento seleccionado ===== -->
            <GroupBox Grid.Column="2" Header="Alojamiento seleccionado" Style="{StaticResource Grupo}"
                      VerticalAlignment="Top" Padding="20,12,20,18">
                <Grid>
                    <!-- Sin selección -->
                    <StackPanel x:Name="PanelSinSeleccion" Margin="0,18,0,10">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource Pincel.Salvia100}">
                            <TextBlock Style="{StaticResource Icono}" Text="&#xE787;" FontSize="18"
                                       Foreground="{StaticResource Pincel.Bosque700}"/>
                        </Border>
                        <TextBlock Text="Ninguna casilla seleccionada" Style="{StaticResource Texto.Base}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="Elige un alojamiento y un día en la cuadrícula para ver su estado."
                                   Style="{StaticResource Texto.Nota}" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Con selección -->
                    <StackPanel x:Name="PanelSeleccion" Visibility="Collapsed">
                        <TextBlock x:Name="TxtSelNombre" Style="{StaticResource Texto.Subtitulo}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtSelFecha" Style="{StaticResource Texto.Secundario}" Margin="0,4,0,0"/>

                        <Border x:Name="ChipSelEstado" Style="{StaticResource Chip.Estado}" Margin="0,10,0,0">
                            <TextBlock x:Name="TxtSelEstado" Style="{StaticResource Chip.EstadoTexto}"/>
                        </Border>
                        <TextBlock x:Name="TxtSelReserva" Style="{StaticResource Texto.Nota}" TextWrapping="Wrap"
                                   Margin="0,8,0,0" Visibility="Collapsed"/>

                        <Border Style="{StaticResource Separador}" Margin="0,14,0,12"/>

                        <TextBlock Text="Estado" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbSelEstado" Style="{StaticResource Campo.Desplegable}" Height="36"
                                  IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Sección en desarrollo"/>
                        <Button x:Name="BtnAplicarEstado" Style="{StaticResource Boton.Secundario}" Content="Aplicar estado"
                                HorizontalAlignment="Stretch" Margin="0,10,0,0"
                                IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Sección en desarrollo"/>

                        <Button x:Name="BtnNuevaReserva" Style="{StaticResource Boton.Primario}" HorizontalAlignment="Stretch"
                                Margin="0,18,0,0" ToolTipService.ShowOnDisabled="True" Click="NuevaReserva_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icono}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Nueva reserva"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Solo disponible si el alojamiento está libre en esa fecha."
                                   Style="{StaticResource Texto.Nota}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</comp:VistaBase>
