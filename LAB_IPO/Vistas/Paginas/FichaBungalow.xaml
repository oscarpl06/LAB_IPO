<UserControl x:Class="LAB_IPO.Vistas.Paginas.FichaBungalow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="Ficha.Etiqueta" TargetType="TextBlock" BasedOn="{StaticResource Texto.Nota}">
            <Setter Property="Width" Value="130"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="Ficha.Valor" TargetType="TextBlock" BasedOn="{StaticResource Texto.Base}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Width" Value="230"/>
        </Style>

        <!-- Miniatura de la galería: borde verde cuando es la foto que se ve en grande -->
        <Style x:Key="Miniatura" TargetType="RadioButton">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTip" Value="Ver esta foto en grande"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border CornerRadius="8">
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill"
                                                ImageSource="{Binding Converter={StaticResource RutaImagen}, ConverterParameter=160}"/>
                                </Border.Background>
                            </Border>
                            <Border x:Name="Marco" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent"
                                    Background="#33FFFFFF"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Marco" Property="Background" Value="Transparent"/>
                                <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource Pincel.Salvia500}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Marco" Property="Background" Value="Transparent"/>
                                <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource Pincel.Bosque700}"/>
                                <Setter TargetName="Marco" Property="BorderThickness" Value="3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- CU-10 · Ficha de consulta de un bungalow (RF-09), en el panel lateral de la ventana principal -->
    <DockPanel>
        <!-- Cabecera -->
        <Grid DockPanel.Dock="Top" Margin="26,22,16,0">
            <StackPanel>
                <TextBlock Text="FICHA DEL BUNGALOW" Style="{StaticResource Texto.Rotulo}"/>
                <TextBlock Text="{Binding Nombre}" Style="{StaticResource Texto.TituloSeccion}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="BtnCerrarFicha" Style="{StaticResource Boton.Ventana}" Width="36" Height="36"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Focusable="True"
                    Content="{StaticResource Icono.Cerrar}" ToolTip="Cerrar la ficha (Esc)"
                    Click="Cerrar_Click"/>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,16,0,0">
            <StackPanel Margin="26,0,26,26">
                <!-- Foto grande con el estado y el precio -->
                <Grid Height="230">
                    <Border CornerRadius="14" Background="{StaticResource Pincel.Salvia100}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icono}" Text="&#xE91B;" FontSize="30"
                                       Foreground="{StaticResource Pincel.Salvia500}"/>
                            <TextBlock Text="Este bungalow no tiene fotos" Style="{StaticResource Texto.Nota}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="14">
                        <Border.Background>
                            <ImageBrush x:Name="FotoGrande" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <Border Style="{StaticResource Chip.Estado}" VerticalAlignment="Top" Margin="14">
                        <TextBlock Text="{Binding EstadoTexto}" Style="{StaticResource Chip.EstadoTexto}"/>
                    </Border>
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="14"
                            Background="#D9FFFFFF" CornerRadius="10" Padding="10,4">
                        <TextBlock>
                            <Run Text="{Binding PrecioTexto, Mode=OneWay}" FontFamily="{StaticResource Fuente.Titulos}"
                                 FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Bosque800}"/>
                            <Run Text=" / noche" FontSize="12" Foreground="{StaticResource Pincel.TextoSecundario}"/>
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- Miniaturas de la galería -->
                <ItemsControl x:Name="Miniaturas" Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource Miniatura}" GroupName="GaleriaFicha"
                                         Checked="Miniatura_Checked"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Datos (RF-09) -->
                <TextBlock Text="Datos del bungalow" Style="{StaticResource Texto.Etiqueta}" FontSize="14"
                           Margin="0,14,0,12"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Tamaño" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding TamanoTexto}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Capacidad máxima" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding CapacidadTexto}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Precio por noche" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding PrecioTexto}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Estancia mínima" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding EstanciaFichaTexto}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>

                <Border Style="{StaticResource Separador}" Margin="0,20,0,18"/>

                <!-- Equipamiento -->
                <TextBlock Text="Equipamiento" Style="{StaticResource Texto.Etiqueta}" FontSize="14" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Equipamiento}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Border x:Name="Marca" Width="22" Height="22" CornerRadius="11"
                                        Background="{StaticResource Pincel.Salvia100}">
                                    <TextBlock x:Name="Glifo" Style="{StaticResource Icono}" FontSize="11"
                                               Text="{StaticResource Icono.Correcto}"
                                               Foreground="{StaticResource Pincel.Bosque700}"/>
                                </Border>
                                <TextBlock x:Name="Nombre" Text="{Binding Nombre}" Style="{StaticResource Texto.Base}"
                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Disponible}" Value="False">
                                    <Setter TargetName="Marca" Property="Background" Value="{StaticResource Pincel.Beige100}"/>
                                    <Setter TargetName="Glifo" Property="Text" Value="&#xE711;"/>
                                    <Setter TargetName="Glifo" Property="Foreground" Value="{StaticResource Pincel.TextoTenue}"/>
                                    <Setter TargetName="Nombre" Property="Foreground" Value="{StaticResource Pincel.TextoTenue}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Separador}" Margin="0,18,0,18"/>

                <!-- Descripción -->
                <TextBlock Text="Descripción" Style="{StaticResource Texto.Etiqueta}" FontSize="14" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding DescripcionTexto}" Style="{StaticResource Texto.Secundario}" FontSize="14"
                           LineHeight="21"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
