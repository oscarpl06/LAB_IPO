<comp:VistaBase x:Class="LAB_IPO.Vistas.Paginas.FormularioBungalowVista"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:comp="clr-namespace:LAB_IPO.Componentes">

    <!-- PG5 · Formulario de bungaló (alta) -->
    <DockPanel>
        <!-- Cabecera -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Nuevo bungalow" Style="{StaticResource Texto.TituloSeccion}"/>
            <TextBlock Text="Registra un bungalow del complejo con sus características, equipamiento y fotos"
                       Style="{StaticResource Texto.Secundario}" Margin="0,6,0,0"/>
            <Border Style="{StaticResource Separador}" Margin="0,14,0,12"/>
        </StackPanel>

        <!-- Pie: errores y botones -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="PanelError" Background="{StaticResource Pincel.ErrorFondo}" CornerRadius="10"
                    Padding="12,8" Margin="0,0,20,0" VerticalAlignment="Center" Visibility="Hidden">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icono}" Text="{StaticResource Icono.Error}"
                               FontSize="14" Foreground="{StaticResource Pincel.Error}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                    <TextBlock x:Name="TxtError" Style="{StaticResource Texto.Base}" Foreground="{StaticResource Pincel.Error}"/>
                </DockPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnCancelarFormulario" Style="{StaticResource Boton.Secundario}" Content="Cancelar"
                        MinWidth="120" Margin="0,0,12,0"
                        ToolTip="Volver a los bungalows sin guardar" Click="Cancelar_Click"/>
                <Button x:Name="BtnGuardar" Style="{StaticResource Boton.Primario}" MinWidth="200"
                        ToolTip="Registrar el bungalow con los datos indicados" Click="Guardar_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icono}" Text="&#xE74E;" FontSize="14" Margin="0,0,8,0"
                                   Foreground="{StaticResource Pincel.Blanco}"/>
                        <TextBlock Text="Guardar bungalow"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,6,0">
            <StackPanel Margin="0,0,0,8">

                <!-- 1. Datos generales -->
                <GroupBox Style="{StaticResource Grupo}" Header="1. Datos generales">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Width="70">
                                <Run Text="Nombre"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                            </TextBlock>
                            <TextBox x:Name="TxtNombre" Style="{StaticResource Campo.Texto}" Width="190" MaxLength="40"
                                     comp:CampoAyudante.TextoEjemplo="Bungalow 08"
                                     ToolTip="Nombre con el que se identifica el bungalow, por ejemplo Bungalow 08"
                                     TextChanged="Campo_Cambiado"/>

                            <TextBlock Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="30,0,10,0">
                                <Run Text="Tamaño (m²)"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                            </TextBlock>
                            <TextBox x:Name="TxtTamano" Style="{StaticResource Campo.Texto}" Width="90" MaxLength="3"
                                     comp:CampoAyudante.TextoEjemplo="Ej. 45"
                                     ToolTip="Superficie del bungalow en metros cuadrados (solo números)"
                                     PreviewTextInput="SoloNumeros" TextChanged="Campo_Cambiado"/>

                            <TextBlock Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="30,0,10,0">
                                <Run Text="Capacidad máx."/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                            </TextBlock>
                            <TextBox x:Name="TxtCapacidad" Style="{StaticResource Campo.Texto}" Width="80" MaxLength="2"
                                     comp:CampoAyudante.TextoEjemplo="Ej. 4"
                                     ToolTip="Número máximo de personas que pueden alojarse"
                                     PreviewTextInput="SoloNumeros" TextChanged="Campo_Cambiado"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Width="130">
                                <Run Text="Precio por noche"/><Run Text=" *" Foreground="{StaticResource Pincel.Error}"/>
                            </TextBlock>
                            <TextBox x:Name="TxtPrecio" Style="{StaticResource Campo.Texto}" Width="110" MaxLength="7"
                                     comp:CampoAyudante.TextoEjemplo="Ej. 65"
                                     ToolTip="Precio por noche en euros. Admite decimales con coma, por ejemplo 65,50"
                                     PreviewTextInput="SoloPrecio" TextChanged="Campo_Cambiado"/>
                            <TextBlock Text="€" Style="{StaticResource Texto.Secundario}" FontSize="14"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>

                            <TextBlock Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="34,0,10,0"
                                       Text="Estancia mínima (opcional)"/>
                            <TextBox x:Name="TxtEstancia" Style="{StaticResource Campo.Texto}" Width="80" MaxLength="2"
                                     comp:CampoAyudante.TextoEjemplo="Ej. 2"
                                     ToolTip="Noches mínimas que hay que reservar. Déjalo vacío si no hay mínimo"
                                     PreviewTextInput="SoloNumeros" TextChanged="Campo_Cambiado"/>
                            <TextBlock Text="noches" Style="{StaticResource Texto.Secundario}" FontSize="14"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 2. Equipamiento -->
                <GroupBox Style="{StaticResource Grupo}" Header="2. Equipamiento" Margin="0,14,0,0">
                    <UniformGrid Columns="4" Margin="-6,0,0,0">
                        <CheckBox x:Name="ChkMenaje" Style="{StaticResource Campo.Casilla}" Content="Menaje"
                                  ToolTip="Vajilla, cubiertos y utensilios de cocina" Click="Campo_Cambiado"/>
                        <CheckBox x:Name="ChkMicroondas" Style="{StaticResource Campo.Casilla}" Content="Microondas"
                                  ToolTip="Dispone de microondas" Click="Campo_Cambiado"/>
                        <CheckBox x:Name="ChkRopa" Style="{StaticResource Campo.Casilla}" Content="Ropa de cama y toallas"
                                  ToolTip="Se entregan sábanas, mantas y toallas" Click="Campo_Cambiado"/>
                        <CheckBox x:Name="ChkWifi" Style="{StaticResource Campo.Casilla}" Content="Wi-Fi"
                                  ToolTip="Conexión inalámbrica a internet" Click="Campo_Cambiado"/>
                    </UniformGrid>
                </GroupBox>

                <!-- 3. Descripción -->
                <GroupBox Style="{StaticResource Grupo}" Header="3. Descripción" Margin="0,14,0,0">
                    <TextBox x:Name="TxtDescripcion" Style="{StaticResource Campo.TextoLargo}" Height="76" MaxLength="400"
                             comp:CampoAyudante.TextoEjemplo="Breve descripción del alojamiento: distribución, ambiente, vistas..."
                             ToolTip="Texto que se mostrará en la ficha del bungalow (opcional)"
                             TextChanged="Campo_Cambiado"/>
                </GroupBox>

                <!-- 4. Galería de fotos -->
                <GroupBox Style="{StaticResource Grupo}" Header="4. Galería de fotos" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtSinFotos" Style="{StaticResource Texto.Secundario}" VerticalAlignment="Center"
                                   Text="Aún no hay fotos. Añade las imágenes del bungalow; la primera será la portada."/>

                        <ItemsControl x:Name="ListaFotos" AlternationCount="1000" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="128" Height="88" Margin="0,0,12,6">
                                        <Border CornerRadius="10" BorderBrush="{StaticResource Pincel.Borde}" BorderThickness="1">
                                            <Border.Background>
                                                <ImageBrush Stretch="UniformToFill"
                                                            ImageSource="{Binding Converter={StaticResource RutaImagen}, ConverterParameter=260}"/>
                                            </Border.Background>
                                        </Border>
                                        <Border x:Name="Portada" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="6"
                                                Background="{StaticResource Pincel.Bosque700}" CornerRadius="8" Padding="7,2"
                                                Visibility="Collapsed">
                                            <TextBlock Text="Portada" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Pincel.Blanco}"/>
                                        </Border>
                                        <Button Style="{StaticResource Boton.VentanaCerrar}" Width="24" Height="24"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                                                Background="#CCFFFFFF" FontSize="9" Focusable="True"
                                                Content="{StaticResource Icono.Cerrar}" Tag="{Binding}"
                                                ToolTip="Quitar esta foto" Click="QuitarFoto_Click"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                                     Value="0">
                                            <Setter TargetName="Portada" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                            <Button x:Name="BtnAnadirFotos" Style="{StaticResource Boton.Secundario}" MinWidth="180"
                                    ToolTip="Elegir una o varias imágenes JPG o PNG del equipo" Click="AnadirFotos_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icono}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Añadir fotos"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource Texto.Nota}" FontSize="11" Margin="0,8,0,0"
                                       HorizontalAlignment="Center" Text="Formatos JPG y PNG."/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</comp:VistaBase>
