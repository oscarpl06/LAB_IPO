<comp:VistaSecundaria x:Class="LAB_IPO.Vistas.Paginas.AcercaDeVista"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:comp="clr-namespace:LAB_IPO.Componentes">

    <comp:VistaSecundaria.Resources>
        <Style x:Key="Dato.Etiqueta" TargetType="TextBlock" BasedOn="{StaticResource Texto.Etiqueta}">
            <Setter Property="Width" Value="190"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="Dato.Valor" TargetType="TextBlock" BasedOn="{StaticResource Texto.Base}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Width" Value="420"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>
        <Style x:Key="Dato.Fila" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </comp:VistaSecundaria.Resources>

    <!-- PG15 · Acerca de -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Acerca de Camping Timoteo" Style="{StaticResource Texto.TituloSeccion}"/>
            <TextBlock Text="Información de autores, versión y propósito de la aplicación."
                       Style="{StaticResource Texto.Secundario}" Margin="0,6,0,0"/>
            <Border Style="{StaticResource Separador}" Margin="0,14,0,14"/>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="BtnVolver" Style="{StaticResource Boton.Primario}" HorizontalAlignment="Right" MinWidth="220"
                    ToolTip="Volver a la pantalla en la que estabas" Click="Volver_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icono}" Text="&#xE72B;" FontSize="13" Margin="0,0,8,0"
                               Foreground="{StaticResource Pincel.Blanco}"/>
                    <TextBlock Text="Volver a la aplicación"/>
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <Border Style="{StaticResource Tarjeta}" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Width="720" Padding="0" Margin="0,4,0,8">
                <StackPanel>
                    <!-- Cabecera de marca -->
                    <Border CornerRadius="14,14,0,0" Background="{StaticResource Pincel.PanelMarca}" Padding="0,26,0,22">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="/LAB_IPO;component/Recursos/Imagenes/logo-texto.png" Height="96" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="GESTIÓN DEL CAMPING" Style="{StaticResource Texto.Rotulo}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="40,26,40,18">
                        <TextBlock Text="Descripción" Style="{StaticResource Texto.Etiqueta}" FontSize="14" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource Texto.Secundario}" FontSize="14" TextWrapping="Wrap" LineHeight="21"
                                   Text="Prototipo de escritorio para gestionar las reservas, el personal, los alojamientos y las actividades de un complejo turístico."/>

                        <Border Style="{StaticResource Separador}" Margin="0,20,0,20"/>

                        <StackPanel Style="{StaticResource Dato.Fila}">
                            <TextBlock Text="Autores" Style="{StaticResource Dato.Etiqueta}"/>
                            <TextBlock Style="{StaticResource Dato.Valor}"
                                       Text="Carlos López y Óscar Puebla · Grado en Ingeniería Informática"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Dato.Fila}">
                            <TextBlock Text="Fecha de realización" Style="{StaticResource Dato.Etiqueta}"/>
                            <TextBlock Style="{StaticResource Dato.Valor}" Text="Octubre de 2026"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Dato.Fila}">
                            <TextBlock Text="Versión" Style="{StaticResource Dato.Etiqueta}"/>
                            <TextBlock Style="{StaticResource Dato.Valor}" Text="2.0.0 · Prototipo de alta fidelidad (WPF)"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Dato.Fila}" Margin="0">
                            <TextBlock Text="Uso" Style="{StaticResource Dato.Etiqueta}"/>
                            <TextBlock Style="{StaticResource Dato.Valor}"
                                       Text="Práctica académica de Interacción Persona-Ordenador I · Curso 2026/2027"/>
                        </StackPanel>

                        <Border Style="{StaticResource Separador}" Margin="0,22,0,14"/>
                        <TextBlock Text="© 2026 · Prototipo académico" Style="{StaticResource Texto.Nota}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </DockPanel>
</comp:VistaSecundaria>
