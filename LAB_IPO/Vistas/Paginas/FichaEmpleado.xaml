<UserControl x:Class="LAB_IPO.Vistas.Paginas.FichaEmpleado"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:LAB_IPO.Componentes">

    <UserControl.Resources>
        <Style x:Key="Ficha.Etiqueta" TargetType="TextBlock" BasedOn="{StaticResource Texto.Nota}">
            <Setter Property="Width" Value="130"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="Ficha.Valor" TargetType="TextBlock" BasedOn="{StaticResource Texto.Base}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Width" Value="230"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
        <Style x:Key="Ficha.Seccion" TargetType="TextBlock" BasedOn="{StaticResource Texto.Etiqueta}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <!-- CU-22 · Ficha de consulta de un empleado (RF-24), en el panel lateral de la ventana principal -->
    <DockPanel>
        <!-- Pie: acceso directo a la edición (CU-23) -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Pincel.Borde}" BorderThickness="0,1,0,0"
                Padding="26,14">
            <Button x:Name="BtnEditarEmpleado" Style="{StaticResource Boton.Primario}" HorizontalAlignment="Stretch"
                    ToolTip="Modificar los datos de este empleado" Click="Editar_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icono}" Text="&#xE70F;" FontSize="14" Margin="0,0,8,0"
                               Foreground="{StaticResource Pincel.Blanco}"/>
                    <TextBlock Text="Editar empleado"/>
                </StackPanel>
            </Button>
        </Border>

        <Grid DockPanel.Dock="Top" Margin="26,22,16,0">
            <TextBlock Text="FICHA DEL EMPLEADO" Style="{StaticResource Texto.Rotulo}"/>
            <Button x:Name="BtnCerrarFicha" Style="{StaticResource Boton.Ventana}" Width="36" Height="36"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Focusable="True"
                    Content="{StaticResource Icono.Cerrar}" ToolTip="Cerrar la ficha (Esc)"
                    Click="Cerrar_Click"/>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,4,0,0">
            <StackPanel Margin="26,0,26,26">
                <!-- Foto, nombre y disponibilidad -->
                <Border Background="{StaticResource Pincel.PanelMarca}" CornerRadius="16" Padding="20,22">
                    <StackPanel>
                        <comp:AvatarUsuario x:Name="Foto" Width="120" Height="120" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding NombreCompleto}" Style="{StaticResource Texto.TituloSeccion}"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,14,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Border CornerRadius="11" Padding="10,3" Background="{StaticResource Pincel.Blanco}">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Bosque800}">
                                    <Run Text="Disponibilidad: "/><Run Text="{Binding Disponibilidad, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                            <Border CornerRadius="11" Padding="10,3" Margin="8,0,0,0" Background="{StaticResource Pincel.Salvia100}">
                                <TextBlock Text="{Binding EstadoTexto}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Pincel.Bosque700}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Contacto -->
                <TextBlock Text="Contacto" Style="{StaticResource Ficha.Seccion}" Margin="0,22,0,12"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Teléfonos" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding TelefonosLista}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Correos" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding CorreosLista}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>

                <Border Style="{StaticResource Separador}" Margin="0,20,0,18"/>

                <!-- Competencias -->
                <TextBlock Text="Competencias y formación" Style="{StaticResource Ficha.Seccion}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Idiomas" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding IdiomasTexto}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Formación" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding FormacionTexto}" Style="{StaticResource Ficha.Valor}" FontWeight="Normal"/>
                </StackPanel>

                <Border Style="{StaticResource Separador}" Margin="0,20,0,18"/>

                <!-- Restricciones de disponibilidad -->
                <TextBlock Text="Disponibilidad y restricciones" Style="{StaticResource Ficha.Seccion}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Franja" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding Disponibilidad}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Días no disponibles" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding DiasNoDisponiblesTexto}" Style="{StaticResource Ficha.Valor}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Restricciones" Style="{StaticResource Ficha.Etiqueta}"/>
                    <TextBlock Text="{Binding RestriccionesTexto}" Style="{StaticResource Ficha.Valor}" FontWeight="Normal"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
