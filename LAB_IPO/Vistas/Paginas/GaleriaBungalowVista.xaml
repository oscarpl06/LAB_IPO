<comp:VistaBase x:Class="LAB_IPO.Vistas.Paginas.GaleriaBungalowVista"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:comp="clr-namespace:LAB_IPO.Componentes"
                Focusable="True" PreviewKeyDown="Vista_PreviewKeyDown">

    <comp:VistaBase.Resources>
        <!-- Flecha para pasar de foto, sobre la imagen grande -->
        <Style x:Key="Boton.Flecha" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" CornerRadius="22" Background="#E6FFFFFF"
                                Effect="{StaticResource Sombra.Tarjeta}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Blanco}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Miniatura: borde verde cuando es la foto seleccionada -->
        <Style x:Key="Miniatura" TargetType="RadioButton">
            <Setter Property="Width" Value="128"/>
            <Setter Property="Height" Value="86"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTip" Value="Ver esta foto en grande"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border CornerRadius="10">
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill"
                                                ImageSource="{Binding Ruta, Converter={StaticResource RutaImagen}, ConverterParameter=260}"/>
                                </Border.Background>
                            </Border>
                            <Border x:Name="Marco" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent"
                                    Background="#40FFFFFF"/>
                            <Border CornerRadius="8" Background="#B3162E1F" Padding="6,1" Margin="6"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding Numero}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Pincel.Blanco}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Marco" Property="Background" Value="Transparent"/>
                                <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource Pincel.Salvia500}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Marco" Property="Background" Value="Transparent"/>
                                <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource Pincel.Bosque700}"/>
                                <Setter TargetName="Marco" Property="BorderThickness" Value="3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </comp:VistaBase.Resources>

    <!-- PG6 · Galería del bungalow (CU-11, CU-12, CU-13) -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TxtTitulo" Style="{StaticResource Texto.TituloSeccion}"/>
            <TextBlock Text="Consulta, añade o elimina las fotos del alojamiento"
                       Style="{StaticResource Texto.Secundario}" Margin="0,6,0,0"/>
            <Border Style="{StaticResource Separador}" Margin="0,14,0,14"/>
        </StackPanel>

        <!-- Pie: aviso y volver -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Icono}" Text="{StaticResource Icono.Info}" FontSize="13"
                           Foreground="{StaticResource Pincel.Info}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource Texto.Nota}" VerticalAlignment="Center"
                           Text="Al eliminar una foto se solicitará confirmación antes de borrarla."/>
            </StackPanel>
            <Button x:Name="BtnVolver" Style="{StaticResource Boton.Secundario}" HorizontalAlignment="Right" MinWidth="190"
                    ToolTip="Volver a la ficha del bungalow" Click="Volver_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icono}" Text="&#xE72B;" FontSize="13" Margin="0,0,8,0"
                               Foreground="{StaticResource Pincel.Bosque800}"/>
                    <TextBlock Text="Volver al bungalow"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Miniaturas -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock x:Name="TxtMiniaturas" Text="Miniaturas" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,8"/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="Miniaturas" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource Miniatura}" GroupName="Galeria"
                                         IsChecked="{Binding Seleccionada, Mode=OneWay}"
                                         AutomationProperties.Name="{Binding Nombre}"
                                         Checked="Miniatura_Checked"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Foto grande con flechas -->
            <Grid>
                <Border CornerRadius="16" Background="{StaticResource Pincel.Salvia100}"
                        BorderBrush="{StaticResource Pincel.Salvia200}" BorderThickness="1">
                    <StackPanel x:Name="PanelVacio" VerticalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource Pincel.Blanco}">
                            <TextBlock Style="{StaticResource Icono}" Text="&#xE91B;" FontSize="26"
                                       Foreground="{StaticResource Pincel.Bosque700}"/>
                        </Border>
                        <TextBlock Text="Este bungalow todavía no tiene fotos" Style="{StaticResource Texto.Etiqueta}"
                                   FontSize="15" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                        <TextBlock Text="Pulsa «Añadir foto» para crear su galería."
                                   Style="{StaticResource Texto.Nota}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="16">
                    <Border.Background>
                        <ImageBrush x:Name="FotoGrande" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <Button x:Name="BtnAnterior" Style="{StaticResource Boton.Flecha}" HorizontalAlignment="Left"
                        Margin="16,0,0,0" ToolTip="Foto anterior (←)" Click="Anterior_Click">
                    <TextBlock Style="{StaticResource Icono}" Text="&#xE76B;" FontSize="14"
                               Foreground="{StaticResource Pincel.Bosque800}"/>
                </Button>
                <Button x:Name="BtnSiguiente" Style="{StaticResource Boton.Flecha}" HorizontalAlignment="Right"
                        Margin="0,0,16,0" ToolTip="Foto siguiente (→)" Click="Siguiente_Click">
                    <TextBlock Style="{StaticResource Icono}" Text="&#xE76C;" FontSize="14"
                               Foreground="{StaticResource Pincel.Bosque800}"/>
                </Button>
                <Border x:Name="ChipPortada" CornerRadius="11" Padding="10,3" Margin="16"
                        Background="#E6FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icono}" Text="&#xE734;" FontSize="11" Margin="0,0,6,0"
                                   Foreground="{StaticResource Pincel.Bosque700}"/>
                        <TextBlock Text="Foto de portada" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Pincel.Bosque800}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Foto seleccionada -->
            <GroupBox Grid.Column="2" Style="{StaticResource Grupo}" Header="Foto seleccionada" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock x:Name="TxtPosicion" Style="{StaticResource Texto.Subtitulo}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtArchivo" Style="{StaticResource Texto.Secundario}" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"/>

                    <Border Style="{StaticResource Separador}" Margin="0,14,0,14"/>

                    <Button x:Name="BtnAnadirFoto" Style="{StaticResource Boton.Primario}" HorizontalAlignment="Stretch"
                            ToolTip="Elegir una o varias fotos JPG o PNG para añadirlas a la galería"
                            Click="AnadirFoto_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icono}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0"
                                       Foreground="{StaticResource Pincel.Blanco}"/>
                            <TextBlock Text="Añadir foto"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnEliminarFoto" Style="{StaticResource Boton.Secundario}" HorizontalAlignment="Stretch"
                            Margin="0,10,0,0" ToolTipService.ShowOnDisabled="True"
                            ToolTip="Quitar de la galería la foto que se ve en grande" Click="EliminarFoto_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icono}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Eliminar foto"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Formatos admitidos: JPG y PNG." Style="{StaticResource Texto.Nota}" Margin="0,12,0,0"/>

                    <!-- Resultado de la última acción -->
                    <Border x:Name="AvisoResultado" CornerRadius="10" Padding="10,8" Margin="0,14,0,0"
                            Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock x:Name="IconoResultado" DockPanel.Dock="Left" Style="{StaticResource Icono}"
                                       FontSize="12" VerticalAlignment="Top" Margin="0,2,8,0"/>
                            <TextBlock x:Name="TxtResultado" Style="{StaticResource Texto.Base}" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</comp:VistaBase>
