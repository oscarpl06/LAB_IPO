<comp:VistaBase x:Class="LAB_IPO.Vistas.Paginas.PersonalVista"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:comp="clr-namespace:LAB_IPO.Componentes">

    <comp:VistaBase.Resources>
        <GridLength x:Key="Col.Foto">70</GridLength>
        <GridLength x:Key="Col.Nombre">190</GridLength>
        <GridLength x:Key="Col.Contacto">210</GridLength>
        <GridLength x:Key="Col.Disponibilidad">140</GridLength>
        <GridLength x:Key="Col.Acciones">236</GridLength>
    </comp:VistaBase.Resources>

    <!-- PG11 · Personal y monitores (listado de empleados) -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Personal y monitores" Style="{StaticResource Texto.TituloSeccion}"/>
            <TextBlock Text="Administra altas, bajas y datos de los empleados temporales de la temporada."
                       Style="{StaticResource Texto.Secundario}" Margin="0,6,0,0"/>
            <Border Style="{StaticResource Separador}" Margin="0,14,0,12"/>

            <!-- Búsqueda y filtros (CU-22) -->
            <GroupBox Style="{StaticResource Grupo}" Header="Búsqueda y filtros" Padding="20,10,20,14"
                      IsEnabled="False" ToolTip="Los filtros estarán disponibles con la consulta de empleados">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Buscar" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Style="{StaticResource Campo.Texto}" Height="34"
                             comp:CampoAyudante.TextoEjemplo="Nombre, email o teléfono"/>
                    <TextBlock Grid.Column="2" Text="Idioma" Style="{StaticResource Texto.Etiqueta}"
                               VerticalAlignment="Center" Margin="18,0,10,0"/>
                    <ComboBox Grid.Column="3" Style="{StaticResource Campo.Desplegable}" Height="34"
                              comp:CampoAyudante.TextoEjemplo="Todos"/>
                    <TextBlock Grid.Column="4" Text="Estado" Style="{StaticResource Texto.Etiqueta}"
                               VerticalAlignment="Center" Margin="18,0,10,0"/>
                    <ComboBox Grid.Column="5" Style="{StaticResource Campo.Desplegable}" Height="34"
                              comp:CampoAyudante.TextoEjemplo="Activo"/>
                    <Button Grid.Column="6" Style="{StaticResource Boton.SecundarioPequeno}" Content="Filtrar"
                            Height="34" Margin="18,0,0,0"/>
                </Grid>
            </GroupBox>

            <!-- Recuento y alta -->
            <Grid Margin="0,16,0,10">
                <TextBlock x:Name="TxtRecuento" Style="{StaticResource Texto.Secundario}" VerticalAlignment="Center"/>
                <Button x:Name="BtnNuevoEmpleado" Style="{StaticResource Boton.Primario}" MinWidth="210"
                        HorizontalAlignment="Right" ToolTip="Dar de alta a un empleado temporal"
                        Click="NuevoEmpleado_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icono}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0"
                                   Foreground="{StaticResource Pincel.Blanco}"/>
                        <TextBlock Text="Nuevo empleado"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Aviso de alta correcta -->
            <Border x:Name="AvisoGuardado" Background="{StaticResource Pincel.Salvia100}" CornerRadius="10"
                    BorderBrush="{StaticResource Pincel.Salvia200}" BorderThickness="1"
                    Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Pincel.Bosque700}">
                        <TextBlock Style="{StaticResource Icono}" Text="{StaticResource Icono.Correcto}" FontSize="11"
                                   Foreground="{StaticResource Pincel.Blanco}"/>
                    </Border>
                    <TextBlock x:Name="TxtAvisoGuardado" Style="{StaticResource Texto.Base}" FontWeight="SemiBold"
                               Foreground="{StaticResource Pincel.Bosque800}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Texto.Nota}" Margin="0,12,0,0"
                   Text="Las miniaturas representan la fotografía asociada a cada ficha de empleado."/>

        <!-- Tabla de empleados -->
        <Border Style="{StaticResource Tarjeta}" CornerRadius="14">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource Pincel.Beige100}" CornerRadius="14,14,0,0"
                        BorderBrush="{StaticResource Pincel.Borde}" BorderThickness="0,0,0,1" Padding="14,0" Height="40">
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Nota}">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{StaticResource Pincel.TextoSecundario}"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Col.Foto}"/>
                            <ColumnDefinition Width="{StaticResource Col.Nombre}"/>
                            <ColumnDefinition Width="{StaticResource Col.Contacto}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="{StaticResource Col.Disponibilidad}"/>
                            <ColumnDefinition Width="{StaticResource Col.Acciones}"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Foto"/>
                        <TextBlock Grid.Column="1" Text="Nombre y apellidos"/>
                        <TextBlock Grid.Column="2" Text="Contacto"/>
                        <TextBlock Grid.Column="3" Text="Idiomas"/>
                        <TextBlock Grid.Column="4" Text="Disponibilidad"/>
                        <TextBlock Grid.Column="5" Text="Acciones"/>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="DesplazamientoEmpleados" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="ListaEmpleados">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Fila" BorderBrush="{StaticResource Pincel.Borde}" BorderThickness="0,0,0,1"
                                        Padding="14,9" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource Col.Foto}"/>
                                            <ColumnDefinition Width="{StaticResource Col.Nombre}"/>
                                            <ColumnDefinition Width="{StaticResource Col.Contacto}"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="{StaticResource Col.Disponibilidad}"/>
                                            <ColumnDefinition Width="{StaticResource Col.Acciones}"/>
                                        </Grid.ColumnDefinitions>

                                        <comp:AvatarUsuario Grid.Column="0" Width="44" Height="44" HorizontalAlignment="Left"
                                                            Nombre="{Binding NombreCompleto}"
                                                            Foto="{Binding RutaFoto, Converter={StaticResource RutaImagen}, ConverterParameter=120}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding NombreCompleto}" Style="{StaticResource Texto.Base}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Telefonos}" Style="{StaticResource Texto.Base}" FontSize="12"/>
                                            <TextBlock Text="{Binding Correos}" Style="{StaticResource Texto.Nota}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding IdiomasTexto}" Style="{StaticResource Texto.Base}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Border Grid.Column="4" CornerRadius="11" Padding="10,3" HorizontalAlignment="Left"
                                                VerticalAlignment="Center" Background="{StaticResource Pincel.Arena200}">
                                            <TextBlock Text="{Binding Disponibilidad}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Pincel.Bosque800}"/>
                                        </Border>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Boton.Fila}" Content="Ver" Margin="0,0,6,0"
                                                    IsEnabled="False" ToolTip="Sección en desarrollo"/>
                                            <Button Style="{StaticResource Boton.Fila}" Content="Editar" Margin="0,0,6,0"
                                                    IsEnabled="False" ToolTip="Sección en desarrollo"/>
                                            <Button Style="{StaticResource Boton.Fila}" Content="Dar de baja"
                                                    IsEnabled="False" ToolTip="Sección en desarrollo"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Fila" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Fila" Property="Background" Value="{StaticResource Pincel.BlancoCalido}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</comp:VistaBase>
