<comp:VentanaBase x:Class="LAB_IPO.Vistas.VentanaPrincipal"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:comp="clr-namespace:LAB_IPO.Componentes"
                  Title="Camping Timoteo  ·  Ventana principal"
                  Width="1240" Height="790" MinWidth="1100" MinHeight="720"
                  WindowStartupLocation="CenterScreen"
                  Icon="/LAB_IPO;component/Recursos/app.ico">

    <!-- PG2 · Ventana principal: cabecera con los datos del usuario, menú lateral y contenido -->
    <Grid Margin="12,0,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Cabecera ===== -->
        <Border Grid.Row="0" Style="{StaticResource Tarjeta}" Height="60" Padding="20,0,14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="/LAB_IPO;component/Recursos/Imagenes/logo-texto.png"
                       Width="105" Height="52" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="GESTIÓN DEL CAMPING" Style="{StaticResource Texto.Rotulo}"
                           Margin="40,0,0,0" VerticalAlignment="Center"/>

                <!-- Usuario conectado: foto, nombre | rol y último acceso -->
                <comp:AvatarUsuario x:Name="Avatar" Grid.Column="3" Width="38" Height="38"
                                    VerticalAlignment="Center"
                                    ToolTip="Foto de perfil del usuario que ha iniciado sesión"/>
                <StackPanel Grid.Column="4" Margin="12,0,24,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Texto.Base}" TextWrapping="NoWrap">
                        <Run x:Name="RunNombre" FontWeight="SemiBold"/>
                        <Run Text="  |  " Foreground="{StaticResource Pincel.TextoTenue}"/>
                        <Run x:Name="RunRol" Foreground="{StaticResource Pincel.TextoSecundario}"/>
                    </TextBlock>
                    <TextBlock x:Name="TxtUltimoAcceso" Style="{StaticResource Texto.Nota}" FontSize="11"
                               TextWrapping="NoWrap" Margin="0,2,0,0"
                               ToolTip="Fecha y hora de tu anterior inicio de sesión"/>
                </StackPanel>

                <Button Grid.Column="5" Style="{StaticResource Boton.SecundarioPequeno}" Content="Cerrar"
                        MinWidth="92" VerticalAlignment="Center"
                        ToolTip="Salir de la aplicación"
                        Click="Cerrar_Click"/>
            </Grid>
        </Border>

        <!-- ===== Cuerpo ===== -->
        <Grid Grid.Row="1" Margin="8,14,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menú lateral -->
            <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="12,16,12,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="Versión 0.1.0  |  2026"
                               Style="{StaticResource Texto.Nota}" FontSize="11" Margin="4,0,0,0"/>

                    <StackPanel>
                        <TextBlock Text="MENÚ PRINCIPAL" Style="{StaticResource Texto.Rotulo}" Margin="4,0,0,0"/>
                        <Border Style="{StaticResource Separador}" Margin="0,10,0,12"/>

                        <RadioButton Style="{StaticResource Boton.Menu}" GroupName="Menu" Content="Inicio"
                                     IsChecked="True" ToolTip="Resumen del día en el camping"/>
                        <RadioButton Style="{StaticResource Boton.Menu}" GroupName="Menu" Content="Reservas"
                                     IsEnabled="False" ToolTip="Sección en desarrollo"/>
                        <RadioButton Style="{StaticResource Boton.Menu}" GroupName="Menu" Content="Personal"
                                     IsEnabled="False" ToolTip="Sección en desarrollo"/>
                        <RadioButton Style="{StaticResource Boton.Menu}" GroupName="Menu" Content="Actividades"
                                     IsEnabled="False" ToolTip="Sección en desarrollo"/>
                        <RadioButton Style="{StaticResource Boton.Menu}" GroupName="Menu" Content="Alojamientos"
                                     IsEnabled="False" ToolTip="Sección en desarrollo"/>
                        <RadioButton Style="{StaticResource Boton.Menu}" GroupName="Menu" Content="Ayuda"
                                     IsEnabled="False" ToolTip="Sección en desarrollo"/>
                        <RadioButton Style="{StaticResource Boton.Menu}" GroupName="Menu" Content="Acerca de"
                                     IsEnabled="False" ToolTip="Sección en desarrollo"/>

                        <Border Style="{StaticResource Separador}" Margin="0,12,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                            <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource Pincel.Salvia100}">
                                <TextBlock Style="{StaticResource Icono}" Text="{StaticResource Icono.Ayuda}" FontSize="15"
                                           Foreground="{StaticResource Pincel.Bosque700}"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Centro de ayuda" Style="{StaticResource Texto.Base}" FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="F1 para consultar" Style="{StaticResource Texto.Nota}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Contenido: Inicio -->
            <StackPanel Grid.Column="2" Margin="0,2,4,0">
                <TextBlock Text="Inicio" Style="{StaticResource Texto.TituloSeccion}"/>
                <TextBlock x:Name="TxtBienvenida" Style="{StaticResource Texto.Secundario}" Margin="0,6,0,0"/>
                <Border Style="{StaticResource Separador}" Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</comp:VentanaBase>
